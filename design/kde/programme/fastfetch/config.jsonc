{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/alpe-logo.txt",
        "padding": {
            "top": 2,
            "left": 2
        },
        "color": {
            "1": "white",
            "2": "blue",
            "3": "magenta"
        }
    },
    "display": {
        "separator": " ➜  ",
        "color": {
            "keys": "magenta",
            "title": "blue"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "command",
            "key": "󰣇 OS     ",
            "text": "alpe version --short"
        },
        {
            "type": "kernel",
            "key": "󰒋 Kernel ",
            "format": "{1} {2}"
        },
        {
            "type": "host",
            "key": "󰌢 Host   "
        },
        {
            "type": "packages",
            "key": "󰏖 PKG    "
        },
        "break",
        {
            "type": "cpu",
            "key": " CPU    ",
            "format": "{1} ({4} Cores)"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU    "
        },
        {
            "type": "memory",
            "key": " RAM    "
        },
        {
            "type": "battery",
            "key": " Akku   "
        },
        "break",
        "colors"
    ]
}
