# Alpe – Paket für Arch Linux und CachyOS (Plan 6.2; E2 im Nachtlauf vom 26.11.2026)
#
# Gebaut wird aus dem Quellarchiv von «make dist» (alpe-shell-<Version>.tar.gz, Go-Module vendort): ohne Netz, mit
# «make build», «go test» und «make install DESTDIR». Kein conflicts/replaces: Das Paket teilt keine Datei mit dem
# Paket von Alpe 1.0, das während des Umzugs als Rückweg installiert bleiben darf (Plan 6.2).
#
# Die Version folgt shell/Common/Brand.qml; Brand.version steigt erst mit G1 auf 1.1 (offene Frage zu pkgver: Plan 6.2
# und 0.8 Nr. 126).

pkgname=alpe-shell
pkgver=1.0
pkgrel=1
pkgdesc='Alpe – Desktop-Shell für Linux, massgeschneidert für die Schweiz (KDE Plasma mit KWin, Hyprland)'
arch=(x86_64 aarch64)
url='https://github.com/alpe-shell/alpe'
# Vollständig aus der Dateiliste von «make install» (Plan 6.2, 0.8 Nr. 113–117, 126; Einzelheiten in NOTICE). Was noch
# ungeklärt ist, steht in Plan 6.2 («Ungeklärt und darum nicht im Feld») und nicht hier.
license=(MIT GPL-3.0-only Apache-2.0 BSD-2-Clause BSD-3-Clause OFL-1.1 CC-BY-3.0 CC-BY-4.0 CC-BY-SA-3.0 CC-BY-SA-4.0
         CC0-1.0 FTL LicenseRef-Alpe-Logo)
depends=('quickshell>=0.3.2' qt6-base qt6-declarative qt6-multimedia qt6-svg accountsservice python matugen wtype
         wireplumber breeze-icons hicolor-icon-theme kora-icon-theme sound-theme-freedesktop)
makedepends=(go make git)
optdepends=('python-h5py: Niederschlagsradar'
            'ffmpeg: Standbild für Videos als Hintergrund der Sperre'
            'kitty: Terminal im Alpe-Design'
            'fastfetch: Systemübersicht im Alpe-Design'
            'kwin-effects-better-blur-dx: Unschärfe unter KDE (AUR)'
            'kwin-effect-rounded-corners: runde Ecken unter KDE (AUR)'
            'hyprlock: Sperre unter Hyprland'
            'hypridle: Ruhezustand unter Hyprland'
            'slurp: Bereich wählen für Bildschirmfotos'
            'cava: Audio-Visualisierung'
            'cups-pk-helper: Drucker einrichten'
            'power-profiles-daemon: Energieprofile'
            'networkmanager: Netzwerk'
            'i2c-tools: Helligkeit externer Bildschirme'
            'qt6ct: Qt-Thema'
            'headsetcontrol: Headsets'
            'dsearch: Dateisuche im Starter')
# Der Dienst ist mit -s -w gebaut (Makefile); ein Debug-Paket bliebe leer.
options=(!debug)
# Das Archiv von «make dist» heisst wie das Paket (Plan 0.8 Nr. 132), nicht wie der «Source code» von GitHub zum Tag.
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
# Die Prüfsumme des veröffentlichten Archivs trägt erst die Veröffentlichung ein (offene Frage, Plan 6.2 und 0.8 Nr. 126).
sha256sums=('SKIP')

_go_umgebung() {
  export CGO_ENABLED=0
  export GOFLAGS='-mod=vendor -trimpath -buildmode=pie'
  export GOPROXY=off
  # Caches im Bauordner, nicht im Home dessen, der baut
  export GOCACHE="$srcdir/go-cache" GOPATH="$srcdir/go-path"
}

build() {
  cd "$pkgname-$pkgver"
  _go_umgebung
  make build
}

check() {
  cd "$pkgname-$pkgver/core"
  _go_umgebung
  # Die Tests des Dienstes laufen mit eigenem Home und eigenen XDG-Ordnern, nie gegen das des Bauenden.
  local heim="$srcdir/check-home"
  mkdir -p "$heim/run"
  chmod 700 "$heim/run"
  env -u DBUS_SESSION_BUS_ADDRESS -u WAYLAND_DISPLAY -u DISPLAY \
    HOME="$heim" XDG_CONFIG_HOME="$heim/.config" XDG_DATA_HOME="$heim/.local/share" XDG_STATE_HOME="$heim/.local/state" \
    XDG_CACHE_HOME="$heim/.cache" XDG_RUNTIME_DIR="$heim/run" \
    go test -count=1 ./...
}

package() {
  cd "$pkgname-$pkgver"
  make install DESTDIR="$pkgdir" PREFIX=/usr
}
