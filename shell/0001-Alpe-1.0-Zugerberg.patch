+#!/usr/bin/env python3
+"""Alpe – Helfer für die KWin-Seiten der Einstellungen.
+
+    alpe-kwin.py state                       Regeln, Effekte, Platzierung, Animation als JSON
+    alpe-kwin.py rule-set JSON               Fensterregel anlegen/ändern (id leer: neu)
+    alpe-kwin.py rule-delete ID              Fensterregel löschen
+    alpe-kwin.py migrate                     kwinrulesrc ins Format von KWin 6.8 bringen (Order statt rules)
+    alpe-kwin.py apply JSON                  [[datei, gruppe, schlüssel, wert], …] schreiben
+                                             (wert null: löschen), danach KWin neu einlesen lassen
+    alpe-kwin.py effect ID on|off            Effekt laden/entladen und dauerhaft (de)aktivieren
+    alpe-kwin.py shortcuts                   alle globalen Tastenkürzel als JSON
+    alpe-kwin.py shortcut-set JSON           {"component","action","componentName","actionName","keys":[int…]}
+    alpe-kwin.py shortcut-new JSON           {"kind":"app","id":"kitty.desktop","name"} oder {"kind":"command","name","command"}, "keys":[int…]
+    alpe-kwin.py shortcut-remove JSON        {"component","action"}: Kürzel weg; eigener Befehl samt Datei
+    alpe-kwin.py apps                        startbare Programme (Desktop-Dateien) als JSON
+    alpe-kwin.py block on|off                globale Kürzel anhalten (während eine Taste aufgenommen wird)
+    alpe-kwin.py pick                        Fenster anklicken lassen (Fadenkreuz), Angaben als JSON
+    alpe-kwin.py services                    systemd-Benutzerdienste als JSON
+    alpe-kwin.py service AKTION UNIT         start|stop|restart|enable|disable (nur --user)
+
+Gelesen wird direkt aus den Dateien in ~/.config, geschrieben nur über kwriteconfig6 (mit
+--notify), damit KDE dieselbe Schreibweise und Sperre verwendet wie seine eigenen Dialoge. Die
+Tastenkürzel laufen über kglobalaccel (D-Bus, busctl), das sie selbst speichert und KWin meldet.
+"""
+import json
+import os
+import re
+import subprocess
+import sys
+import uuid
+
+CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
+KWRITE = os.environ.get("ALPE_KWRITECONFIG", "kwriteconfig6")
+BUSCTL = os.environ.get("ALPE_BUSCTL", "busctl")
+SYSTEMCTL = os.environ.get("ALPE_SYSTEMCTL", "systemctl")
+
+BLUR = "Effect-better-blur-dx"
+CORNERS = "Round-Corners"
+EFFECT_IDS = {"blur": "better_blur_dx", "corners": "kwin4_effect_shapecorners", "kwinblur": "blur"}
+
+# KWin-Regeln: Werte der *rule-Schlüssel (Rules::Type)
+UNUSED, DONT_AFFECT, FORCE, APPLY, REMEMBER = 0, 1, 2, 3, 4
+
+
+# ---------------------------------------------------------------- KConfig lesen
+
+def unescape(value):
+    out, i = [], 0
+    while i < len(value):
+        c = value[i]
+        if c == "\\" and i + 1 < len(value):
+            n = value[i + 1]
+            out.append({"s": " ", "n": "\n", "t": "\t", "r": "\r", "\\": "\\", ";": ";", ",": ","}.get(n, "\\" + n))
+            i += 2
+            continue
+        out.append(c)
+        i += 1
+    return "".join(out)
+
+
+def read_kconfig(name):
+    """{"Gruppe" bzw. "A/B" für [A][B]: {schlüssel: wert}} in Dateireihenfolge."""
+    groups = {}
+    current = None
+    path = os.path.join(CONFIG, name)
+    try:
+        with open(path, encoding="utf-8", errors="replace") as handle:
+            lines = handle.read().splitlines()
+    except FileNotFoundError:
+        return groups
+    for raw in lines:
+        line = raw.strip()
+        if not line or line.startswith("#"):
+            continue
+        if line.startswith("["):
+            names = re.findall(r"\[([^\]]*)\]", line)
+            # [$Version] und ähnliche Markierungen sind keine Gruppen
+            names = [n for n in names if not n.startswith("$")]
+            current = "/".join(names) if names else None
+            if current is not None:
+                groups.setdefault(current, {})
+            continue
+        if current is None or "=" not in line:
+            continue
+        key, value = line.split("=", 1)
+        key = re.sub(r"\[\$[a-z]+\]$", "", key.strip())
+        groups[current][key] = unescape(value.strip())
+    return groups
+
+
+def kwrite(file, group, key, value):
+    cmd = [KWRITE, "--notify", "--file", file]
+    for part in str(group).split("/"):
+        cmd += ["--group", part]
+    cmd += ["--key", key]
+    if value is None:
+        cmd.append("--delete")
+    else:
+        if isinstance(value, bool):
+            value = "true" if value else "false"
+        cmd.append(str(value))
+    try:
+        subprocess.run(cmd, check=False)
+    except FileNotFoundError:
+        sys.exit("%s fehlt – KDE-Einstellungen lassen sich nicht schreiben." % KWRITE)
+
+
+def busctl(*args, json_out=False):
+    cmd = [BUSCTL, "--user"] + (["--json=short"] if json_out else []) + list(args)
+    result = subprocess.run(cmd, capture_output=True, text=True, check=False)
+    if json_out:
+        try:
+            return json.loads(result.stdout)
+        except ValueError:
+            return None
+    return result.returncode == 0
+
+
+def reconfigure():
+    busctl("call", "org.kde.KWin", "/KWin", "org.kde.KWin", "reconfigure")
+    for effect in (EFFECT_IDS["blur"], EFFECT_IDS["corners"]):
+        busctl("call", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "reconfigureEffect", "s", effect)
+
+
+def effect_loaded(effect):
+    data = busctl("call", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "isEffectLoaded", "s", effect, json_out=True)
+    try:
+        return bool(data["data"][0])
+    except (TypeError, KeyError, IndexError):
+        return None
+
+
+def effect_present(effect):
+    for base in ("/usr/lib/qt6/plugins/kwin/effects/plugins", "/usr/lib64/qt6/plugins/kwin/effects/plugins",
+                 "/usr/lib/x86_64-linux-gnu/qt6/plugins/kwin/effects/plugins"):
+        if os.path.exists(os.path.join(base, effect + ".so")):
+            return True
+    return False
+
+
+# ---------------------------------------------------------------- Fensterregeln
+
+RULE_FIELDS = ("Description", "wmclass", "wmclassmatch", "wmclasscomplete", "title", "titlematch", "types",
+               "opacityactive", "opacityactiverule", "opacityinactive", "opacityinactiverule",
+               "noborder", "noborderrule", "position", "positionrule", "size", "sizerule",
+               "above", "aboverule", "placement", "placementrule", "decorationpolicy", "decorationpolicyrule")
+
+# Alpe: KWin 6.8 (ab 6.7.90) hat das Format der kwinrulesrc geändert (Commits «Add support for
+# cascaded window rules» und «Replace no border window rule with a tristate window rule»):
+# - Jede Gruppe ist eine Regel; die Reihenfolge steht in [General] Order. «rules» und «count» sind
+#   veraltet. Steht beim Einlesen noch eine Liste «rules» da, LÖSCHT KWin jede Gruppe, die nicht
+#   darin steht. Alpe schrieb früher bei jeder neuen Regel «rules=<nur diese>» – so verschwanden
+#   alle anderen Regeln (ohne Titelleiste, Deckkraft von Zed …), spätestens beim Neustart.
+# - «Ohne Titelleiste» heisst jetzt decorationpolicy=none|server|client-preference|shadow mit
+#   decorationpolicyrule; noborder/noborderrule migriert KWin beim Lesen und entfernt sie.
+NEW_FORMAT = (6, 7, 90)
+_kwin_version = False
+
+
+def kwin_version():
+    """(6, 8, 3) aus «kwin_wayland --version»; ALPE_KWIN_VERSION überschreibt (Tests), leer = unbekannt."""
+    global _kwin_version
+    if _kwin_version is not False:
+        return _kwin_version
+    text = os.environ.get("ALPE_KWIN_VERSION")
+    if text is None:
+        text = ""
+        for exe in ("kwin_wayland", "kwin_x11"):
+            try:
+                out = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=5, check=False)
+                text = out.stdout + out.stderr
+                if text.strip():
+                    break
+            except (OSError, subprocess.SubprocessError):
+                continue
+    match = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
+    _kwin_version = tuple(int(x) for x in match.groups()) if match else None
+    return _kwin_version
+
+
+def new_format(rc):
+    general = rc.get("General", {})
+    if "Order" in general:
+        return True
+    version = kwin_version()
+    if version is not None:
+        return version >= NEW_FORMAT
+    # Unbekannte Version: ohne alte Liste das neue Format (ein «Order» übersieht ein altes KWin nur,
+    # eine Liste «rules» kostet ein neues KWin alle übrigen Regeln).
+    return "rules" not in general and "count" not in general
+
+
+def rule_groups(rc):
+    return [g for g in rc if g != "General" and not g.startswith("$")]
+
+
+def rule_order(rc):
+    """Kennungen der Regeln in KWins Reihenfolge.
+
+    KWin 6.8: Order, Gruppen ohne Eintrag stellt KWin voran (jede Gruppe ist eine Regel).
+    Ältere Dateien (von KDEs Einstellungsmodul vor Plasma 5.20) haben keine Liste «rules», nur
+    «count» und Gruppen [1] … [n]; die liest KWin bis 6.7 weiterhin. Alpe: Bis dahin hätte
+    eine neue Regel hier die Liste mit nur sich selbst angelegt."""
+    general = rc.get("General", {})
+    if new_format(rc):
+        order = [r for r in general.get("Order", "").split(",") if r and r in rc]
+        return [g for g in rule_groups(rc) if g not in order] + order
+    if "rules" in general:
+        return [r for r in general["rules"].split(",") if r]
+    try:
+        count = int(general.get("count", "0") or 0)
+    except ValueError:
+        count = 0
+    return [str(i) for i in range(1, count + 1) if str(i) in rc]
+
+
+def write_order(rc, order):
+    if new_format(rc):
+        kwrite("kwinrulesrc", "General", "Order", ",".join(order) if order else None)
+    else:
+        kwrite("kwinrulesrc", "General", "rules", ",".join(order) if order else None)
+        kwrite("kwinrulesrc", "General", "count", len(order))
+
+
+def migrate():
+    """Alte Liste «rules»/«count» unter KWin 6.8 durch «Order» mit allen Regeln ersetzen, bevor KWin
+    sie liest und die nicht aufgeführten Gruppen löscht. Zuerst «rules» auf alle Gruppen setzen
+    (liest KWin dazwischen, geht so nichts verloren), dann Order schreiben, dann die alten Schlüssel
+    entfernen. Gibt zurück, ob etwas zu tun war."""
+    rc = read_kconfig("kwinrulesrc")
+    general = rc.get("General", {})
+    if not new_format(rc) or ("rules" not in general and "count" not in general):
+        return False
+    order = rule_order(rc)
+    if order:
+        kwrite("kwinrulesrc", "General", "rules", ",".join(order))
+        kwrite("kwinrulesrc", "General", "Order", ",".join(order))
+    kwrite("kwinrulesrc", "General", "rules", None)
+    kwrite("kwinrulesrc", "General", "count", None)
+    return True
+
+
+def border_values(values):
+    """noborder/noborderrule der Seiten in KWins neue Schlüssel übersetzen (KWin 6.8)."""
+    out = dict(values)
+    if "noborder" in out:
+        flag = out.pop("noborder")
+        out["decorationpolicy"] = None if flag is None else ("none" if flag in (True, "true", 1, "1") else "server")
+        out["noborder"] = None
+    if "noborderrule" in out:
+        out["decorationpolicyrule"] = out.pop("noborderrule")
+        out["noborderrule"] = None
+    return out
+
+
+def border_of(group):
+    """(versteckt?, Regeltyp) aus altem oder neuem Schlüssel"""
+    rule = group.get("decorationpolicyrule") or group.get("noborderrule") or "0"
+    if group.get("decorationpolicyrule"):
+        return group.get("decorationpolicy", "client-preference") == "none", rule
+    return group.get("noborder") == "true", rule
+
+
+def rule_list():
+    rc = read_kconfig("kwinrulesrc")
+    order = rule_order(rc)
+    # Gruppen ohne Eintrag in der Liste liest KWin nicht; sie bleiben aussen vor.
+    rules = []
+    for rid in order:
+        group = rc.get(rid)
+        if group is None:
+            continue
+        rule = {"id": rid}
+        for field in RULE_FIELDS:
+            if field in group:
+                rule[field] = group[field]
+        # Die Seiten kennen «noborder»; KWin 6.8 speichert decorationpolicy.
+        if group.get("decorationpolicyrule"):
+            hidden, kind = border_of(group)
+            rule["noborder"] = "true" if hidden else "false"
+            rule["noborderrule"] = kind
+        rule["other"] = sorted(k for k in group if k not in RULE_FIELDS)
+        rules.append(rule)
+    return rules
+
+
+def blur_classes():
+    value = read_kconfig("kwinrc").get(BLUR, {}).get("WindowClasses", "")
+    return [c.strip() for c in value.split("\n") if c.strip()]
+
+
+def set_blur_class(name, wanted, old_name=""):
+    classes = blur_classes()
+    for drop in {name or "", old_name or ""} - {""}:
+        classes = [c for c in classes if c.lower() != drop.lower()]
+    if wanted and name:
+        classes.append(name)
+    kwrite("kwinrc", BLUR, "WindowClasses", "\n".join(classes) if classes else None)
+
+
+def rule_set(data):
+    migrate()
+    rc = read_kconfig("kwinrulesrc")
+    order = rule_order(rc)
+    rid = data.get("id") or str(uuid.uuid4())
+    old = rc.get(rid, {})
+    values = data.get("values", {})
+    written = border_values(values) if new_format(rc) else values
+    for key, value in written.items():
+        if key not in RULE_FIELDS:
+            continue
+        if value is None and key not in old:
+            continue
+        kwrite("kwinrulesrc", rid, key, value)
+    if rid not in order:
+        order.append(rid)
+        write_order(rc, order)
+    # Weichzeichnen gehört zu Better Blur DX, nicht zu KWins Regeln: Fensterklasse in die Liste.
+    if "blur" in data:
+        wmclass = values.get("wmclass", old.get("wmclass", "")) or ""
+        set_blur_class(wmclass, bool(data["blur"]), old.get("wmclass", "") or "")
+    reconfigure()
+    return rid
+
+
+def rule_delete(rid):
+    migrate()
+    rc = read_kconfig("kwinrulesrc")
+    order = [r for r in rule_order(rc) if r != rid]
+    for key in rc.get(rid, {}):
+        kwrite("kwinrulesrc", rid, key, None)
+    write_order(rc, order)
+    reconfigure()
+
+
+# ---------------------------------------------------------------- Zustand
+
+def state():
+    kwinrc = read_kconfig("kwinrc")
+    plugins = kwinrc.get("Plugins", {})
+    globals_ = read_kconfig("kdeglobals")
+    effects = {}
+    for name, effect in EFFECT_IDS.items():
+        enabled = plugins.get(effect + "Enabled")
+        effects[name] = {
+            "id": effect,
+            "installed": effect_present(effect) if name != "kwinblur" else True,
+            "enabled": None if enabled is None else enabled == "true",
+            "loaded": effect_loaded(effect),
+        }
+    return {
+        "rules": rule_list(),
+        "blurClasses": blur_classes(),
+        "blur": kwinrc.get(BLUR, {}),
+        "corners": kwinrc.get(CORNERS, {}),
+        "effects": effects,
+        "placement": kwinrc.get("Windows", {}).get("Placement", "Centered"),
+        "animation": globals_.get("KDE", {}).get("AnimationDurationFactor", "1"),
+        "focusPolicy": kwinrc.get("Windows", {}).get("FocusPolicy", "ClickToFocus"),
+    }
+
+
+def apply(entries):
+    for file, group, key, value in entries:
+        if file not in ("kwinrc", "kdeglobals", "kwinrulesrc"):
+            continue
+        kwrite(file, group, key, value)
+    reconfigure()
+
+
+def effect_toggle(effect, on):
+    known = set(EFFECT_IDS.values())
+    if effect not in known:
+        sys.exit("unbekannter Effekt")
+    kwrite("kwinrc", "Plugins", effect + "Enabled", bool(on))
+    busctl("call", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "loadEffect" if on else "unloadEffect", "s", effect)
+    # KWins eigene Unschärfe und Better Blur DX schliessen einander aus.
+    if on and effect == EFFECT_IDS["blur"]:
+        kwrite("kwinrc", "Plugins", "blurEnabled", False)
+        busctl("call", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "unloadEffect", "s", "blur")
+
+
+# ---------------------------------------------------------------- Tastenkürzel
+
+APPLICATIONS = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share"), "applications")
+CUSTOM_PREFIX = "net.local."
+
+
+def combos(value):
+    """Tastenkombinationen als Zahlen. kglobalaccel liefert QKeySequence als (ai) – je nach busctl
+    als Zahl oder als verschachtelte Liste [[k1, k2, k3, k4]]; gezählt wird die erste Taste."""
+    out = []
+    for item in value or []:
+        while isinstance(item, list) and len(item) == 1 and isinstance(item[0], list):
+            item = item[0]
+        if isinstance(item, list):
+            item = item[0] if item else 0
+        try:
+            item = int(item)
+        except (TypeError, ValueError):
+            continue
+        if item:
+            out.append(item)
+    return out
+
+
+def desktop_entry(path):
+    """Gruppe [Desktop Entry] einer Desktop-Datei; Name in der Landessprache, wenn vorhanden."""
+    entry, inside = {}, False
+    try:
+        with open(path, encoding="utf-8", errors="replace") as handle:
+            for raw in handle:
+                line = raw.strip()
+                if line.startswith("["):
+                    inside = line == "[Desktop Entry]"
+                    continue
+                if inside and "=" in line and not line.startswith("#"):
+                    key, value = line.split("=", 1)
+                    entry.setdefault(key.strip(), value.strip())
+    except OSError:
+        return {}
+    lang = (os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "").split(".")[0]
+    for key in ("Name[%s]" % lang, "Name[%s]" % lang.split("_")[0]):
+        if lang and entry.get(key):
+            entry["Name"] = entry[key]
+            break
+    return entry
+
+
+def application_dirs():
+    data = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
+    dirs = [APPLICATIONS] + [os.path.join(d, "applications") for d in data.split(":") if d]
+    seen, out = set(), []
+    for d in dirs:
+        if d not in seen and os.path.isdir(d):
+            seen.add(d)
+            out.append(d)
+    return out
+
+
+def apps():
+    """Startbare Programme: erste Desktop-Datei je ID gewinnt (eigene vor Systemdateien), ohne
+    versteckte und ohne die eigenen Befehle (die stehen in der Kürzelliste)."""
+    found = {}
+    for base in application_dirs():
+        for folder, _dirs, files in os.walk(base):
+            for name in files:
+                if not name.endswith(".desktop"):
+                    continue
+                path = os.path.join(folder, name)
+                # Unterordner gehören nach der Spezifikation mit «-» zur ID (kde/foo.desktop → kde-foo.desktop)
+                did = os.path.relpath(path, base).replace(os.sep, "-")
+                if did in found:
+                    continue
+                entry = desktop_entry(path)
+                found[did] = entry
+    out = []
+    for did, entry in found.items():
+        if did.startswith(CUSTOM_PREFIX) or not entry.get("Name") or not entry.get("Exec"):
+            continue
+        if entry.get("Type", "Application") != "Application":
+            continue
+        if entry.get("NoDisplay") == "true" or entry.get("Hidden") == "true":
+            continue
+        out.append({"id": did, "name": entry["Name"]})
+    # Gleiche Namen unterscheidbar machen (etwa zwei Firefox-Einträge)
+    names = {}
+    for app in out:
+        names[app["name"]] = names.get(app["name"], 0) + 1
+    for app in out:
+        if names[app["name"]] > 1:
+            app["name"] = "%s (%s)" % (app["name"], app["id"][:-8])
+    out.sort(key=lambda a: a["name"].lower())
+    return {"apps": out}
+
+
+def custom_path(component):
+    return os.path.join(APPLICATIONS, component)
+
+
+def shortcuts():
+    data = busctl("call", "org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "allMainComponents", json_out=True)
+    components = []
+    try:
+        main = data["data"][0]
+    except (TypeError, KeyError, IndexError):
+        return {"available": False, "components": []}
+    seen = set()
+    for entry in main:
+        unique = entry[0] if entry else ""
+        if not unique or unique in seen:
+            continue
+        seen.add(unique)
+        path = busctl("call", "org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "getComponent", "s", unique, json_out=True)
+        try:
+            opath = path["data"][0]
+        except (TypeError, KeyError, IndexError):
+            continue
+        infos = busctl("call", "org.kde.kglobalaccel", opath, "org.kde.kglobalaccel.Component", "allShortcutInfos", json_out=True)
+        try:
+            rows = infos["data"][0]
+        except (TypeError, KeyError, IndexError):
+            continue
+        actions = []
+        friendly = unique
+        for row in rows:
+            # (uniqueName, friendlyName, componentUnique, componentFriendly, contextUnique, contextFriendly, keys, defaultKeys)
+            friendly = row[3] or friendly
+            actions.append({"action": row[0], "name": row[1] or row[0], "keys": combos(row[6]), "defaults": combos(row[7])})
+        actions.sort(key=lambda a: (a["action"] != "_launch", a["name"].lower()))
+        item = {"component": unique, "name": friendly, "actions": actions}
+        # Alpe: Programme (Komponente = Desktop-Datei) und eigene Befehle kennzeichnen
+        if unique.endswith(".desktop"):
+            item["launch"] = True
+            if unique.startswith(CUSTOM_PREFIX):
+                item["custom"] = True
+                entry = desktop_entry(custom_path(unique))
+                item["name"] = entry.get("Name") or friendly
+                item["command"] = entry.get("Exec", "")
+        components.append(item)
+
+    def order(c):
+        rank = 0 if c["component"] == "kwin" else 1 if c["component"] == "dms" else 2 if c.get("custom") else 3 if c.get("launch") else 4
+        return (rank, c["name"].lower())
+    components.sort(key=order)
+    return {"available": True, "components": components}
+
+
+def set_keys(component, action, component_name, action_name, keys):
+    ident = [component, action, component_name or component, action_name or action]
+    keys = [int(k) for k in keys if int(k) != 0]
+    args = ["call", "org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "setForeignShortcutKeys", "asa(ai)", "4"] + ident
+    args.append(str(len(keys)))
+    for key in keys:
+        args += ["4", str(key), "0", "0", "0"]
+    return busctl(*args)
+
+
+def shortcut_set(data):
+    return set_keys(data["component"], data["action"], data.get("componentName"), data.get("actionName"), data.get("keys", []))
+
+
+def slug(name):
+    text = name.lower()
+    for a, b in (("ä", "ae"), ("ö", "oe"), ("ü", "ue"), ("ß", "ss")):
+        text = text.replace(a, b)
+    text = re.sub(r"[^a-z0-9]+", "-", text).strip("-")
+    return text or "befehl"
+
+
+def write_command(name, command):
+    """Desktop-Datei wie KDEs «Neuer Befehl»: net.local.<name>.desktop in ~/.local/share/applications,
+    unsichtbar im Menü; kglobalaccel startet sie über die Aktion «_launch»."""
+    os.makedirs(APPLICATIONS, exist_ok=True)
+    base = CUSTOM_PREFIX + slug(name)
+    component, n = base + ".desktop", 2
+    while os.path.exists(custom_path(component)):
+        component = "%s-%d.desktop" % (base, n)
+        n += 1
+    clean = lambda v: " ".join(str(v).split())
+    with open(custom_path(component), "w", encoding="utf-8") as handle:
+        handle.write("[Desktop Entry]\n")
+        handle.write("Type=Application\n")
+        handle.write("Name=%s\n" % clean(name))
+        handle.write("Exec=%s\n" % clean(command))
+        handle.write("NoDisplay=true\n")
+        handle.write("StartupNotify=false\n")
+        handle.write("X-KDE-GlobalAccel-CommandShortcut=true\n")
+    return component
+
+
+def shortcut_new(data):
+    keys = data.get("keys", [])
+    name = (data.get("name") or "").strip()
+    if data.get("kind") == "command":
+        command = (data.get("command") or "").strip()
+        if not name or not command:
+            return {"ok": False, "error": "Name und Befehl fehlen"}
+        component = write_command(name, command)
+    else:
+        component = data.get("id") or ""
+        if not component.endswith(".desktop") or "/" in component:
+            return {"ok": False, "error": "unbekanntes Programm"}
+    # doRegister legt für eine Desktop-Datei die Komponente an (liest Exec und Aktionen selbst),
+    # setForeignShortcutKeys gibt «_launch» die Taste und meldet sie KWin.
+    ident = [component, "_launch", name or component, name or component]
+    busctl("call", "org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "doRegister", "as", "4", *ident)
+    ok = set_keys(component, "_launch", ident[2], ident[3], keys)
+    return {"ok": bool(ok), "component": component, "error": "" if ok else "kglobalaccel lehnt ab"}
+
+
+def shortcut_remove(data):
+    component, action = data.get("component", ""), data.get("action", "_launch")
+    set_keys(component, action, component, action, [])
+    if component.endswith(".desktop"):
+        busctl("call", "org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "unregister", "ss", component, action)
+    # Nur eigene Befehle (net.local.*) samt Datei löschen, nie Desktop-Dateien von Programmen.
+    removed = False
+    if component.startswith(CUSTOM_PREFIX) and component.endswith(".desktop") and "/" not in component:
+        try:
+            os.remove(custom_path(component))
+            removed = True
+        except FileNotFoundError:
+            pass
+    return {"ok": True, "removed": removed}
+
+
+# ---------------------------------------------------------------- Fenster anklicken
+
+def pick():
+    """KWin zeigt ein Fadenkreuz; das angeklickte Fenster liefert Klasse, Titel usw."""
+    data = busctl("--timeout=120", "call", "org.kde.KWin", "/KWin", "org.kde.KWin", "queryWindowInfo", json_out=True)
+    try:
+        info = data["data"][0]
+    except (TypeError, KeyError, IndexError):
+        return {}
+    out = {}
+    for key in ("resourceClass", "resourceName", "desktopFile", "caption", "role", "type"):
+        value = info.get(key)
+        if isinstance(value, dict):
+            out[key] = value.get("data")
+    return out
+
+
+# ---------------------------------------------------------------- Dienste
+
+SERVICE_PROPS = ["Id", "Description", "ActiveState", "SubState", "UnitFileState", "FragmentPath", "DropInPaths", "ActiveEnterTimestamp", "MainPID"]
+
+
+def systemctl(*args):
+    return subprocess.run([SYSTEMCTL, "--user", "--no-pager"] + list(args), capture_output=True, text=True, check=False)
+
+
+def services():
+    names = set()
+    for line in systemctl("list-units", "--type=service", "--all", "--plain", "--no-legend").stdout.splitlines():
+        if line.split():
+            names.add(line.split()[0])
+    for line in systemctl("list-unit-files", "--type=service", "--no-legend").stdout.splitlines():
+        parts = line.split()
+        # Vorlagen (name@.service) lassen sich so nicht starten
+        if parts and "@." not in parts[0]:
+            names.add(parts[0])
+    names = sorted(n for n in names if n.endswith(".service") and "@." not in n)
+    if not names:
+        return {"available": False, "services": []}
+    out = systemctl("show", "-p", ",".join(SERVICE_PROPS), *names).stdout
+    home = os.path.expanduser("~")
+    result = []
+    for block in out.split("\n\n"):
+        item = {}
+        for line in block.splitlines():
+            if "=" in line:
+                key, value = line.split("=", 1)
+                item[key] = value
+        if not item.get("Id"):
+            continue
+        fragment = item.get("FragmentPath", "")
+        item["own"] = fragment.startswith(os.path.join(home, ".config", "systemd", "user"))
+        item["dropins"] = [p for p in item.get("DropInPaths", "").split() if p]
+        result.append(item)
+    return {"available": True, "services": result}
+
+
+def service(action, unit):
+    if action not in ("start", "stop", "restart", "enable", "disable") or not re.fullmatch(r"[\w@.:-]+\.service", unit):
+        sys.exit("ungültig")
+    args = [action, unit]
+    if action in ("enable", "disable"):
+        args.insert(1, "--now")
+    result = systemctl(*args)
+    return {"ok": result.returncode == 0, "error": result.stderr.strip()}
+
+
+# ---------------------------------------------------------------- Aufruf
+
+def main(argv):
+    if len(argv) < 2:
+        sys.exit(__doc__)
+    cmd = argv[1]
+    if cmd == "state":
+        print(json.dumps(state(), ensure_ascii=False))
+    elif cmd == "rule-set":
+        print(json.dumps({"id": rule_set(json.loads(argv[2]))}))
+    elif cmd == "migrate":
+        changed = migrate()
+        if changed:
+            reconfigure()
+        print(json.dumps({"migrated": changed, "kwin": ".".join(map(str, kwin_version() or ())) or None}))
+    elif cmd == "rule-delete":
+        rule_delete(argv[2])
+        print("{}")
+    elif cmd == "apply":
+        apply(json.loads(argv[2]))
+        print("{}")
+    elif cmd == "effect":
+        effect_toggle(argv[2], argv[3] == "on")
+        print("{}")
+    elif cmd == "shortcuts":
+        print(json.dumps(shortcuts(), ensure_ascii=False))
+    elif cmd == "shortcut-set":
+        print(json.dumps({"ok": shortcut_set(json.loads(argv[2]))}))
+    elif cmd == "shortcut-new":
+        print(json.dumps(shortcut_new(json.loads(argv[2])), ensure_ascii=False))
+    elif cmd == "shortcut-remove":
+        print(json.dumps(shortcut_remove(json.loads(argv[2]))))
+    elif cmd == "apps":
+        print(json.dumps(apps(), ensure_ascii=False))
+    elif cmd == "block":
+        busctl("call", "org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "blockGlobalShortcuts", "b", "true" if argv[2] == "on" else "false")
+        print("{}")
+    elif cmd == "pick":
+        print(json.dumps(pick(), ensure_ascii=False))
+    elif cmd == "services":
+        print(json.dumps(services(), ensure_ascii=False))
+    elif cmd == "service":
+        print(json.dumps(service(argv[2], argv[3]), ensure_ascii=False))
+    else:
+        sys.exit(__doc__)
+
+
+if __name__ == "__main__":
+    main(sys.argv)
diff --git a/quickshell/scripts/alpe-lockcheck.sh b/quickshell/scripts/alpe-lockcheck.sh
new file mode 100644
index 000000000..003d3f832
--- /dev/null
+++ b/quickshell/scripts/alpe-lockcheck.sh
@@ -0,0 +1,182 @@
+#!/usr/bin/env bash
+# Alpe: prüft den KDE-Sperrbildschirm, ohne die Sitzung zu sperren.
+#
+#   alpe-lockcheck.sh test [paket]
+#                              startet den Sperrbildschirm im Testmodus (ein Fenster, kein
+#                              Sperren; das Passwort schliesst es, sonst nach 90 s von selbst)
+#                              und gibt danach eine Zeile JSON mit dem Befund aus
+#   alpe-lockcheck.sh report   ausführlicher Bericht als Text (für die Fehlersuche)
+#
+# Hintergrund: Lädt das Design des Sperrbildschirms nicht (fehlendes Paket, entferntes globales
+# Design), zeigt KDE ein blaues Notdesign. Der Testmodus zeigt dasselbe gefahrlos und nennt in
+# seinen Meldungen den Grund.
+set -u
+
+CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/alpe"
+LOG="$CACHE/lock-test.log"
+
+greeter() {
+    local candidate
+    for candidate in /usr/lib/kscreenlocker_greet /usr/libexec/kscreenlocker_greet \
+        /usr/lib64/libexec/kscreenlocker_greet /usr/lib/*/libexec/kscreenlocker_greet; do
+        [ -x "$candidate" ] && { printf '%s' "$candidate"; return 0; }
+    done
+    return 1
+}
+
+run_greeter() {   # Sekunden [Shell-Paket]
+    mkdir -p "$CACHE"
+    local bin
+    bin="$(greeter)" || { : > "$LOG"; return 127; }
+    if [ -n "${2:-}" ]; then
+        QT_LOGGING_RULES="${QT_LOGGING_RULES:-kscreenlocker*=true}" timeout "$1" "$bin" --testing --shell "$2" > "$LOG" 2>&1
+    else
+        QT_LOGGING_RULES="${QT_LOGGING_RULES:-kscreenlocker*=true}" timeout "$1" "$bin" --testing > "$LOG" 2>&1
+    fi
+}
+
+fallback_used() { grep -Eqi 'falling back to (built-in|default)|fallbacktheme|Lockscreen QML outdated' "$LOG" 2>/dev/null; }
+
+missing_modules() {
+    # Die Meldung kommt auch verschachtelt vor, dann mit maskierten Anführungszeichen.
+    grep -oE 'module \\?"[^"\\]+\\?" is not installed' "$LOG" 2>/dev/null | sed -E 's/module \\?"([^"\\]+).*/\1/' | sort -u
+}
+
+# Paket zu einem QML-Modul: zuerst die Dateiliste von pacman, sonst eine Tabelle der üblichen.
+package_for() {
+    local module="$1" path found
+    path="usr/lib/qt6/qml/$(printf '%s' "$module" | tr . /)/qmldir"
+    if command -v pacman >/dev/null 2>&1; then
+        found="$(pacman -Fq "$path" 2>/dev/null | head -1 | sed 's|.*/||')"
+        [ -n "$found" ] && { printf '%s' "$found"; return 0; }
+    fi
+    case "$module" in
+        org.kde.breeze.components*|org.kde.plasma.workspace*|org.kde.plasma.private.sessions*|org.kde.plasma.private.keyboardindicator*|org.kde.plasma.wallpapers*|org.kde.plasma.lookandfeel*) printf 'plasma-workspace' ;;
+        org.kde.breeze*) printf 'breeze' ;;
+        org.kde.plasma.plasma5support*) printf 'plasma5support' ;;
+        org.kde.plasma.components*|org.kde.plasma.extras*|org.kde.plasma.core*|org.kde.plasma.plasmoid*) printf 'libplasma' ;;
+        org.kde.kirigami*) printf 'kirigami' ;;
+        org.kde.ksvg*) printf 'ksvg' ;;
+        org.kde.kquickcontrolsaddons*|org.kde.kquickcontrols*) printf 'kdeclarative' ;;
+        org.kde.kscreenlocker*) printf 'kscreenlocker' ;;
+        org.kde.kitemmodels*) printf 'kitemmodels' ;;
+        org.kde.kcmutils*) printf 'kcmutils' ;;
+        org.kde.config*) printf 'kconfig' ;;
+        org.kde.coreaddons*) printf 'kcoreaddons' ;;
+        org.kde.kwindowsystem*) printf 'kwindowsystem' ;;
+        org.kde.desktop*|org.kde.qqc2desktopstyle*) printf 'qqc2-desktop-style' ;;
+        QtQuick.VirtualKeyboard*) printf 'qt6-virtualkeyboard' ;;
+        Qt5Compat*) printf 'qt6-5compat' ;;
+        QtMultimedia*) printf 'qt6-multimedia' ;;
+        *) return 1 ;;
+    esac
+}
+
+suggestion() {
+    local module package packages=""
+    for module in $(missing_modules); do
+        package="$(package_for "$module")" || continue
+        case " $packages " in *" $package "*) ;; *) packages="$packages $package" ;; esac
+    done
+    packages="${packages# }"
+    [ -n "$packages" ] || return 1
+    if command -v pacman >/dev/null 2>&1; then
+        printf 'sudo pacman -S --needed %s' "$packages"
+    elif command -v dnf >/dev/null 2>&1; then
+        printf 'sudo dnf install %s' "$packages"
+    else
+        printf '%s' "$packages"
+    fi
+}
+
+json_string() { printf '%s' "$1" | sed -e 's/[\\"]/\\&/g' | tr -d '\000-\037'; }
+
+summary_json() {   # Rückgabewert des Greeters
+    local code="$1" found=true fallback=false modules="" module first=1 hint
+    greeter >/dev/null || found=false
+    fallback_used && fallback=true
+    for module in $(missing_modules); do
+        [ "$first" = 1 ] || modules="$modules,"
+        modules="$modules\"$(json_string "$module")\""; first=0
+    done
+    hint="$(suggestion || true)"
+    printf '{"greeter":%s,"fallback":%s,"missing":[%s],"suggest":"%s","code":%s,"errors":%s}\n' \
+        "$found" "$fallback" "$modules" "$(json_string "$hint")" "$code" \
+        "$(grep -Eci 'is not installed|unavailable|is not a type|ReferenceError|TypeError' "$LOG" 2>/dev/null || true)"
+}
+
+section() { printf '\n=== %s ===\n' "$1"; }
+read_config() { command -v kreadconfig6 >/dev/null 2>&1 && kreadconfig6 --file "$1" --group "$2" --key "$3" 2>/dev/null; }
+
+case "${1:-}" in
+test)
+    run_greeter 90 "${2:-}"; code=$?
+    summary_json "$code"
+    ;;
+report)
+    echo "Alpe – Bericht zum KDE-Sperrbildschirm, $(date '+%Y-%m-%d %H:%M')"
+    section "Pakete"
+    if command -v pacman >/dev/null 2>&1; then
+        pacman -Q kscreenlocker plasma-workspace libplasma kirigami ksvg kdeclarative plasma5support breeze qqc2-desktop-style kwin 2>&1
+    elif command -v rpm >/dev/null 2>&1; then
+        rpm -q kscreenlocker plasma-workspace libplasma kf6-kirigami kf6-ksvg kf6-kdeclarative plasma5support kwin 2>&1
+    fi
+    section "Design"
+    theme="$(read_config kscreenlockerrc Greeter Theme)"
+    global="$(read_config kdeglobals KDE LookAndFeelPackage)"
+    echo "Sperrbildschirm-Design (kscreenlockerrc): ${theme:-<keins gesetzt>}"
+    echo "Globales Design (kdeglobals):             ${global:-<keins gesetzt, Vorgabe org.kde.breeze.desktop>}"
+    echo "Hintergrund-Plugin:                       $(read_config kscreenlockerrc Greeter WallpaperPlugin)"
+    shell="$(read_config plasmashellrc Shell ShellPackage)"
+    echo "Shell-Paket (plasmashellrc) – daraus kommt der Sperrbildschirm: ${shell:-<Vorgabe org.kde.plasma.desktop>}"
+    for base in "${XDG_DATA_HOME:-$HOME/.local/share}/plasma/shells" /usr/share/plasma/shells; do
+        [ -d "$base" ] && for dir in "$base"/*; do [ -e "$dir/contents/lockscreen/LockScreen.qml" ] && echo "  Sperrbildschirm vorhanden in: $dir"; done
+    done
+    for name in "$theme" "$global" org.kde.breeze.desktop; do
+        [ -n "$name" ] || continue
+        for base in "$HOME/.local/share/plasma/look-and-feel" /usr/share/plasma/look-and-feel; do
+            if [ -d "$base/$name" ]; then
+                printf '  %s/%s: vorhanden' "$base" "$name"
+                [ -e "$base/$name/contents/lockscreen/LockScreen.qml" ] && printf ', mit eigenem Sperrbildschirm' || printf ', ohne eigenen Sperrbildschirm (nimmt die Vorgabe)'
+                printf '\n'
+            fi
+        done
+        [ -d "$HOME/.local/share/plasma/look-and-feel/$name" ] || [ -d "/usr/share/plasma/look-and-feel/$name" ] || echo "  $name: FEHLT"
+    done
+    section "Testlauf (6 Sekunden, sperrt nicht)"
+    if greeter >/dev/null; then
+        echo "Programm: $(greeter)"
+        run_greeter 6; code=$?
+        echo "Rückgabewert: $code (124 heisst: lief bis zum Ende der Testzeit, also normal)"
+        if fallback_used; then echo "BEFUND: Das Design lädt nicht, KDE nimmt das blaue Notdesign."; else echo "Befund: kein Hinweis auf das Notdesign."; fi
+        modules="$(missing_modules | tr '\n' ' ')"
+        [ -n "$modules" ] && echo "Fehlende QML-Module: $modules"
+        hint="$(suggestion || true)"
+        [ -n "$hint" ] && echo "Vorschlag: $hint"
+        echo "--- Meldungen (gekürzt) ---"
+        grep -Ei 'kscreenlocker|falling back|not installed|unavailable|is not a type|Error|PAM|qml' "$LOG" | head -60
+    else
+        echo "kscreenlocker_greet nicht gefunden – ist das Paket kscreenlocker installiert?"
+    fi
+    section "Anmeldung (PAM)"
+    ls -l /etc/pam.d/kde* /usr/lib/pam.d/kde* 2>/dev/null || echo "kein PAM-Dienst kde* gefunden"
+    for file in /etc/pam.d/kde /usr/lib/pam.d/kde; do [ -e "$file" ] && { echo "--- $file ---"; cat "$file"; break; }; done
+    echo "--- gesperrte Fehlversuche ---"; faillock --user "$USER" 2>&1 | head -12
+    ls -l /usr/bin/unix_chkpwd /usr/sbin/unix_chkpwd 2>/dev/null
+    section "Umgebung von KWin"
+    pid="$(pgrep -u "$(id -u)" -f '(^|/)kwin_wayland( |$)' | head -1)"
+    if [ -n "$pid" ] && [ -r "/proc/$pid/environ" ]; then
+        tr '\0' '\n' < "/proc/$pid/environ" | grep -E '^(QML|QT_|KDE_|PLASMA|XDG_CURRENT_DESKTOP|XDG_SESSION)' | sort
+    else
+        echo "kwin_wayland läuft nicht oder ist nicht lesbar"
+    fi
+    section "Journal (letzte Meldungen der Sperre)"
+    journalctl --user -b --no-pager -o cat -g 'kscreenlocker|screenlocker|ksld' 2>/dev/null | tail -40
+    section "Notausgang"
+    echo "Hängt der Sperrbildschirm: Strg+Alt+F3, anmelden, 'loginctl unlock-sessions', zurück mit Strg+Alt+F1 oder F2."
+    ;;
+*)
+    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' >&2
+    exit 2
+    ;;
+esac
diff --git a/quickshell/scripts/alpe-perf.py b/quickshell/scripts/alpe-perf.py
new file mode 100644
index 000000000..e53838280
--- /dev/null
+++ b/quickshell/scripts/alpe-perf.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+"""Alpe – Verbrauch der Shell messen und Teile des Dienstes abschalten.
+
+    alpe-perf.py                 JSON: Prozesse (PSS, CPU %), abgeschaltete Teile, eigener Dienst?
+    alpe-perf.py off NAME on|off Teil des Dienstes ab- (on) oder wieder einschalten (off)
+
+Gemessen wird über /proc: PSS (anteiliger Speicher, ehrlicher als RSS bei geteilten
+Bibliotheken) und CPU-Anteil über 0,5 s. Abgeschaltete Teile stehen in ~/.config/alpe/aus;
+der eigene Dienst liest die Datei beim Start (core/internal/server/alpe_off.go).
+"""
+import json
+import os
+import sys
+import time
+
+CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
+OFF_FILE = os.path.join(CONFIG, "alpe", "aus")
+PARTS = ["bluetooth", "wellbeing", "clipboard", "location", "trayrecovery", "evdev", "notifyactions"]
+PROC = os.environ.get("ALPE_PROC", "/proc")
+
+
+def read(path):
+    try:
+        with open(path, encoding="utf-8", errors="replace") as handle:
+            return handle.read()
+    except OSError:
+        return ""
+
+
+def shell_processes():
+    uid = os.getuid()
+    found = []
+    for pid in os.listdir(PROC):
+        if not pid.isdigit():
+            continue
+        status = read(f"{PROC}/{pid}/status")
+        if not status or f"Uid:\t{uid}" not in status:
+            continue
+        cmdline = read(f"{PROC}/{pid}/cmdline").split("\0")
+        exe = os.path.basename(cmdline[0]) if cmdline and cmdline[0] else ""
+        try:
+            target = os.readlink(f"{PROC}/{pid}/exe")
+        except OSError:
+            target = ""
+        if exe in ("quickshell", "qs") or os.path.basename(target) in ("quickshell", "qs"):
+            kind = "Oberfläche (Quickshell)"
+        elif (exe in ("dms", "alpe") or os.path.basename(target) in ("dms", "alpe")) and "run" in cmdline[1:]:
+            kind = "Dienst (" + ("eigener Bau" if "/.local/lib/alpe/" in target else "Paket") + ")"
+        else:
+            continue
+        found.append({"pid": int(pid), "name": kind, "exe": target})
+    return found
+
+
+def pss_kb(pid):
+    for line in read(f"{PROC}/{pid}/smaps_rollup").splitlines():
+        if line.startswith("Pss:"):
+            return int(line.split()[1])
+    for line in read(f"{PROC}/{pid}/status").splitlines():
+        if line.startswith("VmRSS:"):
+            return int(line.split()[1])
+    return 0
+
+
+def memory_kb(pid):
+    """RSS, PSS und privat (Private_Clean + Private_Dirty) aus smaps_rollup."""
+    values = {"rss": 0, "pss": 0, "private": 0}
+    for line in read(f"{PROC}/{pid}/smaps_rollup").splitlines():
+        key, _, rest = line.partition(":")
+        if not rest.strip():
+            continue
+        amount = int(rest.split()[0])
+        if key == "Rss":
+            values["rss"] = amount
+        elif key == "Pss":
+            values["pss"] = amount
+        elif key in ("Private_Clean", "Private_Dirty"):
+            values["private"] += amount
+    return values
+
+
+def arena_limited(pid):
+    return any(e.startswith("MALLOC_ARENA_MAX=") for e in read(f"{PROC}/{pid}/environ").split("\0"))
+
+
+def cpu_ticks(pid):
+    stat = read(f"{PROC}/{pid}/stat")
+    if not stat:
+        return 0
+    fields = stat.rsplit(")", 1)[-1].split()
+    return int(fields[11]) + int(fields[12])
+
+
+def threads(pid):
+    for line in read(f"{PROC}/{pid}/status").splitlines():
+        if line.startswith("Threads:"):
+            return int(line.split()[1])
+    return 0
+
+
+def read_off():
+    parts = set()
+    for line in read(OFF_FILE).splitlines():
+        name = line.split("#", 1)[0].strip().lower()
+        if name:
+            parts.add(name)
+    return parts
+
+
+def write_off(parts):
+    os.makedirs(os.path.dirname(OFF_FILE), exist_ok=True)
+    body = "# Alpe: Teile des Dienstes, die nicht starten (Einstellungen → Leistung)\n"
+    body += "".join(p + "\n" for p in sorted(parts))
+    tmp = OFF_FILE + ".neu"
+    with open(tmp, "w", encoding="utf-8") as handle:
+        handle.write(body)
+    os.replace(tmp, OFF_FILE)
+
+
+def measure():
+    procs = shell_processes()
+    ticks = os.sysconf("SC_CLK_TCK")
+    before = {p["pid"]: cpu_ticks(p["pid"]) for p in procs}
+    start = time.monotonic()
+    time.sleep(0.5)
+    elapsed = time.monotonic() - start
+    total = 0
+    for p in procs:
+        p["pss"] = pss_kb(p["pid"])
+        mem = memory_kb(p["pid"])
+        p["rss"], p["private"] = mem["rss"], mem["private"]
+        p["arenaLimited"] = arena_limited(p["pid"])
+        p["threads"] = threads(p["pid"])
+        p["cpu"] = round((cpu_ticks(p["pid"]) - before.get(p["pid"], 0)) / ticks / elapsed * 100, 1)
+        total += p["pss"]
+    procs.sort(key=lambda p: -p["pss"])
+    meminfo = {}
+    for line in read(f"{PROC}/meminfo").splitlines():
+        key, _, value = line.partition(":")
+        if value.strip():
+            meminfo[key] = int(value.split()[0])
+    return {
+        "processes": procs,
+        "totalPss": total,
+        "memTotal": meminfo.get("MemTotal", 0),
+        "memAvailable": meminfo.get("MemAvailable", 0),
+        "off": sorted(read_off()),
+        "parts": PARTS,
+        "arenaLimited": any(p.get("arenaLimited") for p in procs if p["name"].startswith("Oberfläche")),
+        "ownBackend": any("/.local/lib/alpe/" in p.get("exe", "") for p in procs),
+    }
+
+
+def main(argv):
+    if len(argv) >= 4 and argv[1] == "off":
+        name, state = argv[2].lower(), argv[3]
+        if name not in PARTS:
+            sys.exit("unbekannter Teil")
+        parts = read_off()
+        if state == "on":
+            parts.add(name)
+        else:
+            parts.discard(name)
+        write_off(parts)
+        print(json.dumps({"off": sorted(parts)}))
+        return
+    print(json.dumps(measure(), ensure_ascii=False))
+
+
+if __name__ == "__main__":
+    main(sys.argv)
diff --git a/quickshell/scripts/alpe-root.sh b/quickshell/scripts/alpe-root.sh
new file mode 100644
index 000000000..33143c47c
--- /dev/null
+++ b/quickshell/scripts/alpe-root.sh
@@ -0,0 +1,76 @@
+#!/bin/sh
+# Alpe – die wenigen Dinge, die Root brauchen. Aufruf über pkexec aus den Einstellungen
+# («Dieses Gerät»); jede Eingabe wird streng geprüft.
+#
+#   alpe-root.sh charge PROZENT              Ladegrenze setzen und beim Start wiederherstellen
+#                                            (100 nimmt die Grenze und den Startdienst weg)
+#   alpe-root.sh lid AKKU NETZ ANGEDOCKT     Verhalten beim Zuklappen (logind)
+#                                            Werte: suspend lock ignore poweroff hibernate
+#
+# Für Tests: ALPE_ROOT_PREFIX setzt ein Verzeichnis vor /etc und /sys.
+set -eu
+P="${ALPE_ROOT_PREFIX:-}"
+
+batteries() {
+    for bat in "$P"/sys/class/power_supply/*; do
+        [ "$(cat "$bat/type" 2>/dev/null)" = Battery ] && printf '%s\n' "$bat"
+    done
+}
+
+case "${1:-}" in
+charge)
+    value="${2:-}"
+    case "$value" in ''|*[!0-9]*) echo "ungültig: $value" >&2; exit 2 ;; esac
+    [ "$value" -ge 50 ] && [ "$value" -le 100 ] || { echo "erlaubt: 50–100" >&2; exit 2; }
+    found=0
+    for bat in $(batteries); do
+        if [ -w "$bat/charge_control_end_threshold" ] || [ -n "$P" ]; then
+            echo "$value" > "$bat/charge_control_end_threshold" && found=1
+        fi
+    done
+    [ "$found" = 1 ] || { echo "kein Akku mit charge_control_end_threshold" >&2; exit 3; }
+    unit="$P/etc/systemd/system/alpe-ladegrenze.service"
+    if [ "$value" -ge 100 ]; then
+        rm -f "$P/etc/alpe/ladegrenze"
+        [ -n "$P" ] || systemctl disable --now alpe-ladegrenze.service >/dev/null 2>&1 || true
+        rm -f "$unit"
+    else
+        mkdir -p "$P/etc/alpe" "$(dirname "$unit")"
+        echo "$value" > "$P/etc/alpe/ladegrenze"
+        cat > "$unit" <<UNIT
+[Unit]
+Description=Alpe: Ladegrenze des Akkus wiederherstellen
+After=sysinit.target
+
+[Service]
+Type=oneshot
+# systemd ersetzt \$NAME selbst; für die Shell steht deshalb \$\$.
+ExecStart=/bin/sh -c 'v=\$\$(cat /etc/alpe/ladegrenze); for b in /sys/class/power_supply/*; do [ "\$\$(cat \$\$b/type 2>/dev/null)" = Battery ] && [ -w \$\$b/charge_control_end_threshold ] && echo \$\$v > \$\$b/charge_control_end_threshold; done; true'
+
+[Install]
+WantedBy=multi-user.target
+UNIT
+        [ -n "$P" ] || { systemctl daemon-reload; systemctl enable alpe-ladegrenze.service >/dev/null 2>&1; }
+    fi
+    echo "ok"
+    ;;
+lid)
+    for v in "${2:-}" "${3:-}" "${4:-}"; do
+        case "$v" in suspend|lock|ignore|poweroff|hibernate) ;; *) echo "ungültig: $v" >&2; exit 2 ;; esac
+    done
+    dir="$P/etc/systemd/logind.conf.d"
+    mkdir -p "$dir"
+    cat > "$dir/60-alpe-deckel.conf" <<CONF
+# Alpe: Verhalten beim Zuklappen (Einstellungen → Dieses Gerät)
+[Login]
+HandleLidSwitch=$2
+HandleLidSwitchExternalPower=$3
+HandleLidSwitchDocked=$4
+CONF
+    # logind liest seine Einstellungen bei SIGHUP neu (systemd ≥ 254).
+    [ -n "$P" ] || systemctl kill -s HUP systemd-logind.service >/dev/null 2>&1 || true
+    echo "ok"
+    ;;
+*)
+    sed -n '2,12p' "$0" >&2; exit 2 ;;
+esac
diff --git a/quickshell/scripts/alpe-update.sh b/quickshell/scripts/alpe-update.sh
new file mode 100644
index 000000000..71ee6172d
--- /dev/null
+++ b/quickshell/scripts/alpe-update.sh
@@ -0,0 +1,101 @@
+#!/usr/bin/env bash
+# Alpe: Systemaktualisierung mit dem eigenen Wartungsbefehl in einem Terminalfenster.
+#
+#   alpe-update.sh launch <Terminal oder ""> <Befehl> [Terminal-Argumente ...]
+#       öffnet ein Terminal in einer eigenen systemd-Scope. So überlebt die
+#       Aktualisierung einen Neustart der Shell, etwa wenn sie Quickshell erneuert.
+#   alpe-update.sh run <Befehl>
+#       läuft im Terminal: führt den Befehl aus und hält den Stand fest.
+#   alpe-update.sh open <Terminal oder ""> <Titel> <Programm> [Argumente ...]
+#       beliebiges Programm in einem Terminalfenster, etwa ein Protokoll.
+#
+# Stand: ~/.local/state/alpe/update.json, von der Shell beobachtet.
+set -u
+
+STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/alpe"
+STATE="$STATE_DIR/update.json"
+TITLE="Alpe – Systemaktualisierung"
+APP_ID="alpe.update"
+
+json_string() { printf '%s' "$1" | sed -e 's/[\\"]/\\&/g' | tr -d '\000-\037'; }
+
+write_state() {   # Zustand, Beginn, Ende, Code
+    mkdir -p "$STATE_DIR" || return 1
+    printf '{"state":"%s","command":"%s","started":%s,"finished":%s,"code":%s}\n' \
+        "$1" "$(json_string "$COMMAND")" "$2" "$3" "$4" > "$STATE.$$.tmp" && mv -f "$STATE.$$.tmp" "$STATE"
+}
+
+find_terminal() {
+    local wanted="$1" candidate
+    for candidate in "$wanted" "${TERMINAL:-}" kitty ghostty foot alacritty wezterm konsole gnome-terminal xterm; do
+        [ -n "$candidate" ] && command -v "$candidate" >/dev/null 2>&1 && { printf '%s' "$candidate"; return 0; }
+    done
+    return 1
+}
+
+case "${1:-}" in
+open)
+    wanted="${2:-}"; TITLE="${3:-Alpe}"; shift 3 2>/dev/null || shift $#
+    [ $# -gt 0 ] || { echo "kein Programm angegeben" >&2; exit 2; }
+    terminal="$(find_terminal "$wanted")" || { echo "kein Terminal gefunden" >&2; exit 3; }
+    APP_ID="alpe.terminal"
+    case "$(basename "$terminal")" in
+        kitty|alacritty) argv=("$terminal" --class "$APP_ID" -T "$TITLE" -e) ;;
+        foot)            argv=("$terminal" "--app-id=$APP_ID" "--title=$TITLE") ;;
+        ghostty)         argv=("$terminal" "--class=$APP_ID" "--title=$TITLE" -e) ;;
+        wezterm)         argv=("$terminal" start --always-new-process --class "$APP_ID" --) ;;
+        konsole)         argv=("$terminal" -p "tabtitle=$TITLE" -e) ;;
+        gnome-terminal)  argv=("$terminal" "--title=$TITLE" --) ;;
+        *)               argv=("$terminal" -e) ;;
+    esac
+    exec setsid -f "${argv[@]}" "$@"
+    ;;
+launch)
+    wanted="${2:-}"; COMMAND="${3:-}"; shift 3 2>/dev/null || shift $#
+    if [ -z "$COMMAND" ]; then echo "kein Befehl angegeben" >&2; exit 2; fi
+    terminal="$(find_terminal "$wanted")" || { echo "kein Terminal gefunden" >&2; exit 3; }
+    self="$(readlink -f "$0")"
+    case "$(basename "$terminal")" in
+        kitty|alacritty) argv=("$terminal" --class "$APP_ID" -T "$TITLE" "$@" -e) ;;
+        foot)            argv=("$terminal" "--app-id=$APP_ID" "--title=$TITLE" "$@") ;;
+        ghostty)         argv=("$terminal" "--class=$APP_ID" "--title=$TITLE" "$@" -e) ;;
+        wezterm)         argv=("$terminal" start --always-new-process --class "$APP_ID" "$@" --) ;;
+        konsole)         argv=("$terminal" -p "tabtitle=$TITLE" "$@" -e) ;;
+        gnome-terminal)  argv=("$terminal" --wait "--title=$TITLE" "$@" --) ;;
+        *)               argv=("$terminal" "$@" -e) ;;
+    esac
+    argv+=(bash "$self" run "$COMMAND")
+    if command -v systemd-run >/dev/null 2>&1; then
+        exec systemd-run --user --scope --collect --quiet --unit "alpe-update-$(date +%s)" -- "${argv[@]}"
+    fi
+    exec setsid -f "${argv[@]}"
+    ;;
+run)
+    COMMAND="${2:-}"
+    case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
+    if [ -z "$COMMAND" ]; then echo "kein Befehl angegeben" >&2; exit 2; fi
+    started="$(date +%s)"; finished=0; code=-1; state="aborted"
+    # Wird das Fenster mitten im Lauf geschlossen, bleibt "aborted" stehen statt "running".
+    trap 'write_state "$state" "$started" "$(date +%s)" "$code"' EXIT
+    trap 'exit 130' HUP INT TERM
+    write_state running "$started" 0 null
+    printf '\033[1;36m=== %s ===\033[0m\n\033[2m$ %s\033[0m\n\n' "$TITLE" "$COMMAND"
+    bash -c "$COMMAND"
+    code=$?
+    if [ "$code" -eq 0 ]; then
+        state="done"
+        printf '\n\033[1;32m=== Fertig. Eingabetaste schliesst das Fenster. ===\033[0m\n'
+    else
+        state="failed"
+        printf '\n\033[1;31m=== Mit Fehlern beendet (Code %s). Eingabetaste schliesst das Fenster. ===\033[0m\n' "$code"
+    fi
+    write_state "$state" "$started" "$(date +%s)" "$code"
+    trap - EXIT
+    read -r _ || true
+    exit "$code"
+    ;;
+*)
+    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' >&2
+    exit 2
+    ;;
+esac
