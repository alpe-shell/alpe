+    // Jede Änderung geht hierdurch: Stand für «Rückgängig» merken, übernehmen, verzögert speichern.
+    // Gleichartige Änderungen kurz hintereinander (Schieberegler, Mausrad) zählen als eine.
+    function commit(next, key) {
