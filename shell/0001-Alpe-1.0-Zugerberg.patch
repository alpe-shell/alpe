+    }
+}
diff --git a/quickshell/Modules/Settings/AlpeMaintenanceTab.qml b/quickshell/Modules/Settings/AlpeMaintenanceTab.qml
new file mode 100644
index 000000000..b4c57cc5a
--- /dev/null
+++ b/quickshell/Modules/Settings/AlpeMaintenanceTab.qml
@@ -0,0 +1,242 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.Common
+import qs.Services
+import qs.DCommon.Widgets
+import qs.Modules.Settings.Widgets
+
+// Alpe: Wartung der Shell selbst – Neustart, Protokoll, Zwischenspeicher, eigene Plugins und
+// der Schutz des Backend-Pakets vor fremden Aktualisierungen.
+Item {
+    id: root
+
+    property var parentModal: null
+
+    property string cacheSize: ""
+    property bool cacheBusy: false
+    // "", "held", "open", "unknown"
+    property string holdState: ""
+    property string treeState: ""
+
+    readonly property var ownPlugins: (PluginService.availablePluginsList || []).filter(plugin => String(plugin.id).startsWith("alpe"))
+
+    function probe() {
+        prober.running = false;
+        prober.running = true;
+    }
+
+    function parse(text) {
+        for (const line of text.split("\n")) {
+            const cut = line.indexOf("=");
+            if (cut < 0)
+                continue;
+            const value = line.slice(cut + 1).trim();
+            switch (line.slice(0, cut)) {
+            case "cache":
+                cacheSize = value;
+                break;
+            case "hold":
+                holdState = value;
+                break;
+            case "tree":
+                treeState = value;
+                break;
+            }
+        }
+        cacheBusy = false;
+    }
+
+    function restartShell() {
+        Quickshell.execDetached(["sh", "-c", 'if systemctl --user is-active --quiet dms.service; then exec systemctl --user restart dms.service; fi; exec "$1" restart', "sh", Proc.dmsBin]);
+    }
+
+    function openJournal() {
+        Quickshell.execDetached(["sh", "-c", 'for term in "$1" "${TERMINAL:-}" kitty ghostty foot alacritty konsole; do [ -n "$term" ] && command -v "$term" >/dev/null 2>&1 && exec "$term" -e journalctl --user -u dms.service -b -e; done', "sh", SessionData.resolveTerminal()]);
+    }
+
+    function clearCache() {
+        cacheBusy = true;
+        cacheCleaner.running = true;
+    }
+
+    function lastRunText() {
+        const run = SystemUpdateService.scriptRun;
+        if (!run || !(run.started > 0))
+            return "Noch nie über Alpe gestartet";
+        const when = new Date((run.finished > 0 ? run.finished : run.started) * 1000).toLocaleString(I18n.locale(), Locale.ShortFormat);
+        switch (run.state) {
+        case "running":
+            return "Läuft gerade";
+        case "done":
+            return when + " · ohne Fehler";
+        case "failed":
+            return when + " · mit Fehlern (Code " + run.code + ")";
+        default:
+            return when + " · abgebrochen";
+        }
+    }
+
+    function treeText() {
+        switch (treeState) {
+        case "clean":
+            return "Unverändert gegenüber dem letzten Commit";
+        case "dirty":
+            return "Enthält Änderungen ohne Commit";
+        case "nogit":
+            return "Kein Git-Arbeitsverzeichnis";
+        default:
+            return "";
+        }
+    }
+
+    Process {
+        id: prober
+        running: true
+        command: ["sh", "-c", 'dir="${XDG_CACHE_HOME:-$HOME/.cache}/alpe"; if [ -d "$dir" ]; then printf "cache=%s\\n" "$(du -sh "$dir" 2>/dev/null | cut -f1)"; else echo "cache=leer"; fi; case "${DMS_EXECUTABLE:-}" in */.local/lib/alpe/*) echo hold=own ;; *) if command -v pacman-conf >/dev/null 2>&1; then if pacman -Qq "$1" >/dev/null 2>&1; then if pacman-conf IgnorePkg 2>/dev/null | grep -qx "$1"; then echo hold=held; else echo hold=open; fi; else echo hold=unknown; fi; else echo hold=unknown; fi ;; esac; if git -C "$2" rev-parse --is-inside-work-tree >/dev/null 2>&1; then if [ -z "$(git -C "$2" status --porcelain 2>/dev/null)" ]; then echo tree=clean; else echo tree=dirty; fi; else echo tree=nogit; fi', "sh", Brand.heldPackages[0] ?? "", Quickshell.shellDir]
+        stdout: StdioCollector {
+            onStreamFinished: root.parse(text)
+        }
+    }
+
+    Process {
+        id: cacheCleaner
+        command: ["sh", "-c", 'dir="${XDG_CACHE_HOME:-$HOME/.cache}/alpe"; [ -d "$dir" ] && find "$dir" -mindepth 1 -delete; exit 0']
+        onExited: {
+            WeatherService.forceRefresh();
+            root.probe();
+        }
+    }
+
+    SettingsPage {
+        SettingsCard {
+            width: parent.width
+            iconName: "terminal"
+            title: "Shell"
+            settingKey: "alpeMaintenanceShell"
+
+            SettingsRow {
+                title: `${Brand.name} ${Brand.version} «${Brand.codename}»`
+                subtitle: root.treeText()
+                iconName: "landscape"
+                trailingBadge: ShellVersionService.shellVersion
+            }
+
+            SettingsRow {
+                title: "Shell neu starten"
+                subtitle: "Lädt Oberfläche und Plugins neu. Offene Programme bleiben unberührt."
+                iconName: "restart_alt"
+
+                DButton {
+                    anchors.verticalCenter: parent.verticalCenter
+                    buttonHeight: Theme.buttonHeightS
+                    text: I18n.tr("Restart")
+                    iconName: "restart_alt"
+                    backgroundColor: SettingsMetrics.controlSurface
+                    textColor: Theme.surfaceText
+                    onClicked: root.restartShell()
+                }
+            }
+
+            SettingsRow {
+                title: "Protokoll"
+                subtitle: "Meldungen der Shell seit dem Systemstart, im Terminal"
+                iconName: "receipt_long"
+                clickable: true
+                resetKeys: []
+                onClicked: root.openJournal()
+
+                DIcon {
+                    anchors.verticalCenter: parent.verticalCenter
+                    name: "open_in_new"
+                    size: Theme.iconSize
+                    color: Theme.surfaceVariantText
+                }
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "system_update_alt"
+            title: "Aktualisierung"
+            settingKey: "alpeMaintenanceUpdate"
+
+            SettingsNavRow {
+                title: I18n.tr("Software updates", "settings page, modal and bar widget title, DMS and system package updates")
+                hint: (SystemUpdateService.scriptMode ? SystemUpdateService.scriptCommand + " · " : "") + root.lastRunText()
+                iconName: "system_update_alt"
+                onClicked: keyboard => root.parentModal?.navigateTo("updater", keyboard)
+            }
+
+            SettingsRow {
+                visible: root.holdState !== "" && root.holdState !== "unknown" && Brand.heldPackages.length > 0
+                title: root.holdState === "own" ? "Eigener Hintergrunddienst" : "Paket «" + (Brand.heldPackages[0] ?? "") + "»"
+                subtitle: root.holdState === "own" ? "Aus demselben Quellcode gebaut wie diese Shell (tools/backend.sh); er passt immer, eine Ausnahme in pacman ist unnötig." : root.holdState === "held" ? "In pacman festgehalten. Das Backend passt damit sicher zu dieser Shell." : "Nicht festgehalten: Eine Paketaktualisierung könnte ein Backend bringen, das nicht mehr zu dieser Shell passt."
+                iconName: root.holdState === "open" ? "gpp_maybe" : "verified_user"
+                iconColor: root.holdState === "open" ? Theme.warning : Theme.primary
+                trailingBadge: root.holdState === "own" ? "alpe" : root.holdState === "held" ? "IgnorePkg" : "offen"
+                trailingBadgeColor: root.holdState === "open" ? Theme.warning : Theme.surfaceVariantText
+            }
+
+            SettingsNoteRow {
+                visible: root.holdState === "open"
+                noteIconName: "terminal"
+                monospace: true
+                text: "sudo sed -i -E 's/^#?[[:space:]]*IgnorePkg[[:space:]]*=[[:space:]]*(.*)$/IgnorePkg = \\1 " + (Brand.heldPackages[0] ?? "") + "/' /etc/pacman.conf"
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "cached"
+            title: "Zwischenspeicher"
+            settingKey: "alpeMaintenanceCache"
+
+            SettingsRow {
+                title: "Wetter und Radar"
+                subtitle: "Stationsliste, amtliche Tagesprognose und Radarbilder. Wird nach dem Leeren neu geladen."
+                iconName: "partly_cloudy_day"
+                trailingBadge: root.cacheSize
+
+                DButton {
+                    anchors.verticalCenter: parent.verticalCenter
+                    buttonHeight: Theme.buttonHeightS
+                    text: "Leeren"
+                    iconName: "delete_sweep"
+                    busy: root.cacheBusy
+                    enabled: !root.cacheBusy
+                    backgroundColor: SettingsMetrics.controlSurface
+                    textColor: Theme.surfaceText
+                    onClicked: root.clearCache()
+                }
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "extension"
+            title: "Eigene Plugins"
+            settingKey: "alpeMaintenancePlugins"
+            visible: root.ownPlugins.length > 0
+
+            Repeater {
+                model: ScriptModel {
+                    values: root.ownPlugins
+                }
+
+                SettingsNavRow {
+                    id: pluginRow
+                    required property var modelData
+                    readonly property bool pluginLoaded: PluginService.loadedPlugins[modelData.id] !== undefined
+                    title: modelData.name || modelData.id
+                    hint: (pluginLoaded ? "Aktiv" : "Nicht geladen") + (modelData.version ? " · Version " + modelData.version : "")
+                    iconName: modelData.icon || "extension"
+                    iconColor: pluginLoaded ? Theme.primary : Theme.surfaceVariantText
+                    onClicked: keyboard => root.parentModal?.navigateTo(SettingsTabs.pluginPrefix + modelData.id, keyboard)
+                }
+            }
+        }
+    }
+}
diff --git a/quickshell/Modules/Settings/AlpePagesTab.qml b/quickshell/Modules/Settings/AlpePagesTab.qml
new file mode 100644
index 000000000..03fb4d871
--- /dev/null
+++ b/quickshell/Modules/Settings/AlpePagesTab.qml
@@ -0,0 +1,99 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import qs.Common
+import qs.Services
+import qs.DCommon.Widgets
+import qs.Modules.Settings.Widgets
+
+// Alpe: Einstellungsseiten ausblenden, die man nicht braucht. Ausgeblendet heisst nur: nicht
+// mehr in der Seitenleiste und in der Suche. Die Einstellungen dahinter bleiben, wie sie sind.
+Item {
+    id: root
+
+    property var parentModal: null
+
+    // Was auf diesem Rechner ohnehin fehlt (Akku, WLAN, Mobilfunk …), steht gar nicht zur Wahl.
+    readonly property var topEntries: SettingsTabs.structure.filter(entry => !entry.separator && root.available(entry.id))
+    readonly property var hubs: topEntries.filter(entry => root.listedChildren(entry).length > 1)
+    readonly property int hiddenCount: SettingsTabs.hiddenList.filter(id => !SettingsTabs.isPinned(id) && SettingsTabs.page(id) && root.available(id)).length
+
+    function listedChildren(entry) {
+        return (entry.children || []).filter(child => !child.hidden && root.available(child.id));
+    }
+
+    function available(id) {
+        return SettingsTabs.isAvailable(SettingsTabs.page(id));
+    }
+
+    function note(entry) {
+        if (SettingsTabs.isPinned(entry.id))
+            return "Immer sichtbar";
+        return entry.hint || SettingsTabs.hubHint(SettingsTabs.page(entry.id)) || "";
+    }
+
+    component PageToggle: SettingsToggleRow {
+        required property var modelData
+        text: modelData.text
+        description: root.note(modelData)
+        iconName: modelData.icon
+        enabled: !SettingsTabs.isPinned(modelData.id)
+        checked: !SettingsTabs.isHiddenByUser(modelData.id)
+        // Verzögert: Die Änderung kann die Liste neu aufbauen, in der diese Zeile steht.
+        onToggled: checked => {
+            const id = modelData.id;
+            Qt.callLater(() => SettingsTabs.setPageHidden(id, !checked));
+        }
+    }
+
+    SettingsPage {
+        SettingsCard {
+            width: parent.width
+            iconName: "visibility"
+            title: "Bereiche"
+            settingKey: "alpePages"
+
+            SettingsRow {
+                title: root.hiddenCount === 0 ? "Alle Seiten sichtbar" : root.hiddenCount === 1 ? "1 Seite ausgeblendet" : root.hiddenCount + " Seiten ausgeblendet"
+                subtitle: "Ausgeblendete Seiten verschwinden aus Seitenleiste und Suche. Ihre Einstellungen bleiben unverändert wirksam."
+                iconName: "visibility_off"
+
+                DButton {
+                    anchors.verticalCenter: parent.verticalCenter
+                    buttonHeight: Theme.buttonHeightS
+                    visible: root.hiddenCount > 0
+                    text: "Alle einblenden"
+                    iconName: "visibility"
+                    backgroundColor: SettingsMetrics.controlSurface
+                    textColor: Theme.surfaceText
+                    onClicked: SettingsData.set("settingsHiddenPages", [])
+                }
+            }
+
+            Repeater {
+                model: root.topEntries
+
+                PageToggle {}
+            }
+        }
+
+        Repeater {
+            model: root.hubs
+
+            SettingsCard {
+                id: hubCard
+                required property var modelData
+                width: parent.width
+                iconName: modelData.icon
+                title: modelData.text
+                visible: !SettingsTabs.isHiddenByUser(modelData.id)
+
+                Repeater {
+                    model: root.listedChildren(hubCard.modelData)
+
+                    PageToggle {}
+                }
+            }
+        }
+    }
+}
diff --git a/quickshell/Modules/Settings/AlpePerformanceTab.qml b/quickshell/Modules/Settings/AlpePerformanceTab.qml
new file mode 100644
index 000000000..0032e2293
--- /dev/null
+++ b/quickshell/Modules/Settings/AlpePerformanceTab.qml
@@ -0,0 +1,171 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import qs.Common
+import qs.Services
+import qs.DCommon.Widgets
+import qs.Modules.Settings.Widgets
+
+// Alpe: Leistung. Was Oberfläche und Dienst gerade an Speicher und Rechenzeit brauchen
+// (scripts/alpe-perf.py, nur solange die Seite offen ist), und Schalter für Teile, die nicht
+// jeder braucht: im Dienst (~/.config/alpe/aus, wirkt nach einem Neustart der Shell, nur mit
+// dem eigenen Dienst) und in der Oberfläche (Einstellungen der Shell, wirken sofort).
+Item {
+    id: root
+
+    property var parentModal: null
+
+    property var info: null
+    property bool restartNeeded: false
+    readonly property string script: Quickshell.shellDir + "/scripts/alpe-perf.py"
+
+    function refresh() {
+        Proc.runCommand("alpe-perf", ["python3", "-I", script], (output, code) => {
+            try {
+                root.info = JSON.parse(output);
+            } catch (e) {}
+        }, 0, 10000);
+    }
+
+    Timer {
+        interval: 3000
+        repeat: true
+        triggeredOnStart: true
+        running: root.visible
+        onTriggered: root.refresh()
+    }
+
+    function mb(kb) {
+        return (kb / 1024).toFixed(kb < 102400 ? 1 : 0) + " MB";
+    }
+
+    function setPart(name, off) {
+        Proc.runCommand("alpe-perf-off-" + name, ["python3", "-I", script, "off", name, off ? "on" : "off"], () => {
+            root.restartNeeded = true;
+            root.refresh();
+        }, 0, 10000);
+    }
+
+    // Teile des Dienstes: [Name, Titel, Beschreibung]
+    readonly property var parts: [
+        ["bluetooth", "Bluetooth", "Geräte, Akkustände und Kopplung über BlueZ. Aus, wenn der Rechner kein Bluetooth nutzt."],
+        ["wellbeing", "Digitales Wohlbefinden", "Erfasst Bildschirmzeit je Programm für die Statistik und App-Limits."],
+        ["clipboard", "Verlauf der Zwischenablage", "Merkt sich Kopiertes; ohne ihn bleibt nur das Einfügen des Letzten."],
+        ["location", "Standort", "Für Nachtlicht und Dunkelmodus nach Sonnenstand. Das Wetter von MeteoSchweiz braucht ihn nicht."],
+        ["trayrecovery", "Tray-Wiederherstellung", "Holt Symbole im Systembereich nach einem Absturz von Programmen zurück."],
+        ["evdev", "Tastatur-Ereignisse", "Für die Anzeigen von Feststell- und Num-Taste."],
+        ["notifyactions", "Aktionen in Mitteilungen", "Knöpfe in Mitteilungen anderer Programme."]
+    ]
+
+    // Teile der Oberfläche: [Einstellung, Titel, Beschreibung, an ist teuer?]
+    readonly property var uiParts: [
+        ["audioVisualizerEnabled", "Audio-Visualisierung", "Startet cava, solange Musik läuft; kostet dauernd etwas CPU."],
+        ["launcherHistoryEnabled", "Verlauf im Starter", "Merkt sich gestartete Programme für die Reihenfolge."],
+        ["notificationHistoryEnabled", "Verlauf der Mitteilungen", "Hält alte Mitteilungen im Speicher."],
+        ["soundsEnabled", "Systemklänge", "Klänge bei Mitteilungen, Lautstärke usw."]
+    ]
+
+    SettingsPage {
+        SettingsCard {
+            width: parent.width
+            iconName: "speed"
+            title: "Verbrauch"
+            settingKey: "alpePerformance"
+            tags: ["leistung", "ram", "speicher", "cpu", "performance"]
+
+            SettingsNoteRow {
+                visible: root.info === null
+                text: "Messe …"
+            }
+
+            Repeater {
+                model: root.info ? root.info.processes : []
+
+                SettingsRow {
+                    required property var modelData
+                    width: parent ? parent.width : 0
+                    title: modelData.name
+                    // Alpe: RSS zählt geteilte Bibliotheken und Grafiktreiber voll (so steht es im
+                    // Systemmonitor); PSS teilt sie auf, «privat» gehört nur diesem Prozess.
+                    subtitle: "PID " + modelData.pid + " · " + modelData.threads + " Threads" + (modelData.rss ? " · RSS " + root.mb(modelData.rss) + ", privat " + root.mb(modelData.private) : "")
+                    iconName: modelData.name.startsWith("Oberfläche") ? "web_asset" : "deployed_code"
+                    trailingBadge: root.mb(modelData.pss) + " · " + modelData.cpu.toFixed(1) + " % CPU"
+                }
+            }
+
+            SettingsNoteRow {
+                visible: root.info !== null && root.info.arenaLimited === false
+                noteIconName: "info"
+                text: "Speicher-Arenen nicht begrenzt: bash ~/alpe/install.sh setzt MALLOC_ARENA_MAX=2 für den Dienst (danach Shell neu starten). Das hält RSS bei vielen Zeichen-Threads tiefer."
+            }
+
+            SettingsRow {
+                visible: root.info !== null
+                title: "Zusammen"
+                subtitle: root.info ? "von " + root.mb(root.info.memTotal) + " Arbeitsspeicher, frei " + root.mb(root.info.memAvailable) + ". Gemessen als PSS: geteilte Bibliotheken zählen anteilig." : ""
+                iconName: "memory"
+                trailingBadge: root.info ? root.mb(root.info.totalPss) : ""
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "deployed_code"
+            title: "Teile des Dienstes"
+            settingKey: "alpePerformanceBackend"
+
+            SettingsNoteRow {
+                visible: root.info !== null && !root.info.ownBackend
+                text: "Läuft mit dem Dienst aus dem Paket: Diese Schalter wirken erst mit dem eigenen Dienst (bash ~/alpe/tools/backend.sh build, dann use alpe)."
+            }
+
+            Repeater {
+                model: root.parts
+
+                SettingsToggleRow {
+                    required property var modelData
+                    width: parent ? parent.width : 0
+                    text: modelData[1]
+                    description: modelData[2]
+                    checked: !(root.info && root.info.off.indexOf(modelData[0]) >= 0)
+                    onToggled: checked => root.setPart(modelData[0], !checked)
+                }
+            }
+
+            SettingsRow {
+                visible: root.restartNeeded
+                title: "Wirkt nach einem Neustart der Shell"
+                subtitle: "Offene Fenster bleiben."
+                iconName: "restart_alt"
+
+                DButton {
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: "Neu starten"
+                    variant: "tonal"
+                    onClicked: Quickshell.execDetached(["sh", "-c", "systemctl --user restart dms.service 2>/dev/null || dms restart"])
+                }
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "web_asset"
+            title: "Teile der Oberfläche"
+            settingKey: "alpePerformanceUi"
+
+            Repeater {
+                model: root.uiParts
+
+                SettingsToggleRow {
+                    required property var modelData
+                    width: parent ? parent.width : 0
+                    text: modelData[1]
+                    description: modelData[2]
+                    checked: !!SettingsData[modelData[0]]
+                    onToggled: checked => SettingsData.set(modelData[0], checked)
+                }
+            }
+        }
+    }
+}
diff --git a/quickshell/Modules/Settings/AlpePeripheralsTab.qml b/quickshell/Modules/Settings/AlpePeripheralsTab.qml
new file mode 100644
index 000000000..6b1e886de
--- /dev/null
+++ b/quickshell/Modules/Settings/AlpePeripheralsTab.qml
@@ -0,0 +1,200 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import qs.Common
+import qs.Services
+import qs.DCommon.Widgets
+import qs.Modules.Settings.Widgets
+
+// Alpe: Akkustände von Maus, Tastatur und Headset. Was UPower meldet, erscheint von selbst;
+// Funk-Headsets mit eigenem Empfänger kommen über HeadsetService dazu.
+Item {
+    id: root
+
+    property var parentModal: null
+
+    readonly property var intervalValues: [60, 120, 300, 600, 900]
+    readonly property var intervalOptions: intervalValues.map(seconds => I18n.duration(seconds))
+
+    function percentColor(percentage) {
+        if (percentage <= SettingsData.headsetBatteryLowThreshold)
+            return Theme.error;
+        if (percentage <= 30)
+            return Theme.warning;
+        return Theme.surfaceVariantText;
+    }
+
+    function headsetSubtitle(dev) {
+        switch (dev.state) {
+        case "ok":
+            return dev.charging ? "Lädt" : "Verbunden";
+        case "off":
+            return "Ausgeschaltet oder ausser Reichweite";
+        default:
+            return "Keine Antwort vom Headset";
+        }
+    }
+
+    function toolName(tool) {
+        return tool === "hyper_headset_cli" ? "HyperHeadset" : tool === "headsetcontrol" ? "HeadsetControl" : "";
+    }
+
+    function headsetStatus() {
+        if (!HeadsetService.checked)
+            return HeadsetService.busy ? "Wird abgefragt …" : "Noch nicht abgefragt";
+        if (HeadsetService.toolMissing)
+            return "Kein Auslesewerkzeug installiert";
+        if (HeadsetService.devices.length === 0)
+            return HeadsetService.error === "nodevice" ? "Kein unterstütztes Headset gefunden – steckt der Empfänger?" : HeadsetService.error;
+        return "über " + toolName(HeadsetService.tool);
+    }
+
+    Component.onCompleted: {
+        BatteryService.addRef();
+        HeadsetService.addRef();
+    }
+    Component.onDestruction: {
+        BatteryService.removeRef();
+        HeadsetService.removeRef();
+    }
+
+    SettingsPage {
+        SettingsCard {
+            width: parent.width
+            iconName: "battery_full"
+            title: "Geräte"
+            settingKey: "alpePeripherals"
+
+            Repeater {
+                model: ScriptModel {
+                    values: BatteryService.upowerPeripherals
+                }
+
+                SettingsRow {
+                    id: upowerRow
+                    required property var modelData
+                    title: modelData.name
+                    subtitle: modelData.charging ? "Lädt" : "Verbunden"
+                    iconName: modelData.icon
+                    trailingBadge: modelData.percentage + " %"
+                    trailingBadgeColor: root.percentColor(modelData.percentage)
+                }
+            }
+
+            Repeater {
+                model: ScriptModel {
+                    values: SettingsData.headsetBatteryEnabled ? HeadsetService.devices : []
+                }
+
+                SettingsRow {
+                    id: headsetRow
+                    required property var modelData
+                    title: modelData.name
+                    subtitle: root.headsetSubtitle(modelData)
+                    iconName: "headset_mic"
+                    trailingBadge: modelData.percentage >= 0 ? modelData.percentage + " %" : "–"
+                    trailingBadgeColor: modelData.percentage >= 0 ? root.percentColor(modelData.percentage) : Theme.surfaceVariantText
+                }
+            }
+
+            SettingsRow {
+                visible: BatteryService.upowerPeripherals.length === 0 && (!SettingsData.headsetBatteryEnabled || HeadsetService.devices.length === 0)
+                title: "Keine Geräte mit Akkustand"
+                subtitle: "Funkmaus oder Tastatur erscheinen, sobald sie verbunden sind."
+                iconName: "battery_unknown"
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "headset_mic"
+            title: "Headset"
+            settingKey: "alpeHeadset"
+
+            SettingsToggleRow {
+                settingKey: "headsetBatteryEnabled"
+                tags: ["headset", "battery", "akku", "hyperx", "kopfhörer"]
+                text: "Akkustand des Headsets auslesen"
+                description: "Erscheint hier und als Ring in der Energie-Anzeige neben der Maus."
+                checked: SettingsData.headsetBatteryEnabled
+                onToggled: checked => SettingsData.set("headsetBatteryEnabled", checked)
+            }
+
+            SettingsRow {
+                visible: SettingsData.headsetBatteryEnabled
+                title: "Status"
+                subtitle: root.headsetStatus()
+                iconName: HeadsetService.toolMissing || (HeadsetService.checked && HeadsetService.devices.length === 0) ? "error_outline" : "check_circle"
+                iconColor: HeadsetService.toolMissing || (HeadsetService.checked && HeadsetService.devices.length === 0) ? Theme.warning : Theme.primary
+
+                DButton {
+                    anchors.verticalCenter: parent.verticalCenter
+                    buttonHeight: Theme.buttonHeightS
+                    text: "Jetzt abfragen"
+                    iconName: "refresh"
+                    busy: HeadsetService.busy
+                    enabled: !HeadsetService.busy
+                    backgroundColor: SettingsMetrics.controlSurface
+                    textColor: Theme.surfaceText
+                    onClicked: HeadsetService.refresh()
+                }
+            }
+
+            SettingsNoteRow {
+                visible: SettingsData.headsetBatteryEnabled && HeadsetService.toolMissing
+                noteIconName: "terminal"
+                monospace: true
+                text: "paru -S headsetcontrol        # die meisten Headsets, HyperX Cloud II Wireless\nparu -S hyper-headset-bin     # HyperX, auch Cloud II Core Wireless"
+            }
+
+            SettingsNoteRow {
+                visible: SettingsData.headsetBatteryEnabled && HeadsetService.checked && !HeadsetService.toolMissing && HeadsetService.devices.length === 0
+                noteIconName: "info"
+                text: "Installiert: " + HeadsetService.tools.map(tool => root.toolName(tool)).join(", ") + ". Findet keines davon das Headset, fehlt meist die udev-Regel (Empfänger nach der Installation einmal aus- und einstecken) oder das Modell wird vom anderen Werkzeug unterstützt."
+            }
+
+            SettingsDropdownRow {
+                settingKey: "headsetBatteryInterval"
+                visible: SettingsData.headsetBatteryEnabled
+                text: "Abfrage im Hintergrund"
+                description: "Für die Warnung. Solange eine Anzeige offen ist, wird alle 30 Sekunden abgefragt."
+                enabled: SettingsData.headsetBatteryNotifyLow
+                options: root.intervalOptions
+                currentValue: root.intervalOptions[Math.max(0, root.intervalValues.indexOf(SettingsData.headsetBatteryInterval))]
+                onValueChanged: value => {
+                    const index = root.intervalOptions.indexOf(value);
+                    if (index >= 0)
+                        SettingsData.set("headsetBatteryInterval", root.intervalValues[index]);
+                }
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "notifications"
+            title: "Warnung"
+            settingKey: "alpeHeadsetAlert"
+            visible: SettingsData.headsetBatteryEnabled
+
+            SettingsToggleRow {
+                settingKey: "headsetBatteryNotifyLow"
+                text: "Bei tiefem Akkustand warnen"
+                description: "Einmal je Entladung, als Hinweis am Bildschirmrand."
+                checked: SettingsData.headsetBatteryNotifyLow
+                onToggled: checked => SettingsData.set("headsetBatteryNotifyLow", checked)
+            }
+
+            SettingsSliderRow {
+                settingKey: "headsetBatteryLowThreshold"
+                text: "Schwelle"
+                unit: "%"
+                enabled: SettingsData.headsetBatteryNotifyLow
+                value: SettingsData.headsetBatteryLowThreshold
+                minimum: 5
+                maximum: 40
+                onSliderValueChanged: newValue => SettingsData.set("headsetBatteryLowThreshold", newValue)
+            }
+        }
+    }
+}
diff --git a/quickshell/Modules/Settings/AlpeServicesTab.qml b/quickshell/Modules/Settings/AlpeServicesTab.qml
new file mode 100644
index 000000000..a5cbbf6fa
--- /dev/null
+++ b/quickshell/Modules/Settings/AlpeServicesTab.qml
@@ -0,0 +1,237 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import qs.Common
+import qs.Services
+import qs.DCommon.Widgets
+import qs.Modules.Settings.Widgets
+
+// Alpe: Dienste und Autostart. Die Shell selbst (dms.service mit ihren Drop-ins), eigene
+// systemd-Benutzerdienste (~/.config/systemd/user) mit Start, Stopp und Autostart, die übrigen
+// Benutzerdienste zum Ansehen und Neustarten. Autostart-Programme hat die eigene Seite.
+Item {
+    id: root
+
+    property var parentModal: null
+
+    property var info: null
+    property bool loading: false
+    property bool showAll: false
+    property string message: ""
+
+    AlpeKwinBackend {
+        id: backend
+    }
+
+    function refresh() {
+        loading = true;
+        backend.run(["services"], result => {
+            loading = false;
+            if (result)
+                info = result;
+        });
+    }
+
+    Component.onCompleted: refresh()
+
+    readonly property var all: info ? info.services : []
+    readonly property var shell: all.find(s => s.Id === "dms.service") || null
+    // Maskierte Dienste (Verweis auf /dev/null) sind bewusst abgeschaltet: nur nennen, nicht schalten.
+    readonly property var own: all.filter(s => s.own && s.Id !== "dms.service" && s.UnitFileState !== "masked")
+    readonly property var masked: all.filter(s => s.UnitFileState === "masked")
+    readonly property var others: all.filter(s => !s.own && s.Id !== "dms.service" && !launchedApp(s.Id) && s.UnitFileState !== "masked" && (s.ActiveState === "active" || s.ActiveState === "failed"))
+
+    function act(action, unit) {
+        message = "";
+        backend.run(["service", action, unit], result => {
+            if (result && !result.ok)
+                message = unit + ": " + (result.error || "fehlgeschlagen");
+            refresh();
+        });
+    }
+
+    function stateText(s) {
+        if (!s)
+            return "";
+        const map = { "active": "läuft", "inactive": "gestoppt", "failed": "fehlgeschlagen", "activating": "startet", "deactivating": "stoppt" };
+        return (map[s.ActiveState] || s.ActiveState) + (s.ActiveState === "active" && s.ActiveEnterTimestamp ? " seit " + s.ActiveEnterTimestamp.replace(/^\w+ /, "") : "");
+    }
+
+    // Über scripts/alpe-update.sh open: sucht ein vorhandenes Terminal (kitty, ghostty, foot …).
+    function journal(unit) {
+        Quickshell.execDetached(["bash", Quickshell.shellDir + "/scripts/alpe-update.sh", "open", SessionData.resolveTerminal(), "Protokoll: " + unit, "journalctl", "--user", "-u", unit, "-n", "200", "-f"]);
+    }
+
+    // systemd schreibt Sonderzeichen als \x2d usw.; Autostart-Einträge heissen app-NAME@autostart.
+    function pretty(id) {
+        let name = String(id).replace(/\.service$/, "").replace(/\\x([0-9a-fA-F]{2})/g, (m, h) => String.fromCharCode(parseInt(h, 16)));
+        const auto = name.match(/^app-(.+)@autostart$/);
+        return auto ? "Autostart: " + auto[1] : name;
+    }
+
+    // Von systemd gestartete Programmfenster (app-kitty@<Kennung>) sind keine Dienste im eigentlichen Sinn.
+    function launchedApp(id) {
+        return /^app-.+@[0-9a-f]{16,}\.service$/.test(String(id));
+    }
+
+    SettingsPage {
+        SettingsCard {
+            width: parent.width
+            iconName: "deployed_code"
+            title: "Shell"
+            settingKey: "alpeServiceShell"
+            tags: ["dienste", "services", "systemd", "dms.service", "neustart"]
+
+            SettingsRow {
+                title: "Alpe (dms.service)"
+                subtitle: root.shell ? root.stateText(root.shell) : (root.loading ? "lese …" : "nicht als Dienst eingerichtet")
+                iconName: root.shell && root.shell.ActiveState === "active" ? "check_circle" : "error_outline"
+                iconColor: root.shell && root.shell.ActiveState === "active" ? Theme.primary : Theme.error
+
+                DButton {
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: "Protokoll"
+                    iconName: "receipt_long"
+                    variant: "text"
+                    onClicked: root.journal("dms.service")
+                }
+            }
+
+            SettingsRow {
+                visible: !!(root.shell && root.shell.dropins.length > 0)
+                title: "Ergänzungen (Drop-ins)"
+                subtitle: root.shell ? root.shell.dropins.map(p => p.split("/").pop()).join(" · ") : ""
+                iconName: "tune"
+            }
+
+            SettingsRow {
+                title: "Shell neu starten"
+                subtitle: "Startet Leiste, Dock und diese Einstellungen neu; offene Fenster bleiben."
+                iconName: "restart_alt"
+
+                DButton {
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: "Neu starten"
+                    variant: "tonal"
+                    onClicked: Quickshell.execDetached(["systemctl", "--user", "restart", "dms.service"])
+                }
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "settings_applications"
+            title: "Eigene Dienste"
+            settingKey: "alpeServiceOwn"
+
+            SettingsNoteRow {
+                visible: root.info !== null && root.own.length === 0
+                text: "Keine eigenen Dienste in ~/.config/systemd/user."
+            }
+
+            SettingsRow {
+                visible: root.masked.length > 0
+                title: "Bewusst abgeschaltet (maskiert)"
+                subtitle: root.masked.map(s => root.pretty(s.Id)).join(" · ") + " – zurück mit «systemctl --user unmask NAME»"
+                iconName: "block"
+            }
+
+            SettingsNoteRow {
+                visible: root.message !== ""
+                text: root.message
+            }
+
+            Repeater {
+                model: root.own
+
+                SettingsToggleRow {
+                    id: svc
+                    required property var modelData
+                    width: parent ? parent.width : 0
+                    text: root.pretty(modelData.Id)
+                    description: (modelData.Description && modelData.Description !== modelData.Id ? modelData.Description + " · " : "") + root.stateText(modelData) + " · Autostart " + (modelData.UnitFileState === "enabled" ? "an" : "aus")
+                    checked: modelData.UnitFileState === "enabled"
+                    onToggled: checked => root.act(checked ? "enable" : "disable", modelData.Id)
+
+                    accessory: Row {
+                        spacing: Theme.spacingXS
+                        DButton {
+                            text: svc.modelData.ActiveState === "active" ? "Stoppen" : "Starten"
+                            variant: "text"
+                            onClicked: root.act(svc.modelData.ActiveState === "active" ? "stop" : "start", svc.modelData.Id)
+                        }
+                        DButton {
+                            text: "Neu starten"
+                            variant: "text"
+                            visible: svc.modelData.ActiveState === "active"
+                            onClicked: root.act("restart", svc.modelData.Id)
+                        }
+                        DButton {
+                            text: "Protokoll"
+                            variant: "text"
+                            onClicked: root.journal(svc.modelData.Id)
+                        }
+                    }
+                }
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "list"
+            title: "Weitere Benutzerdienste"
+            settingKey: "alpeServiceOthers"
+
+            SettingsToggleRow {
+                text: "Laufende Dienste des Systems zeigen"
+                description: root.others.length + " Dienste aus Paketen (PipeWire, Schlüsselbund …). Nur ansehen und neu starten; an- und abschalten lieber nicht."
+                checked: root.showAll
+                onToggled: checked => root.showAll = checked
+            }
+
+            Repeater {
+                model: root.showAll ? root.others : []
+
+                SettingsRow {
+                    id: other
+                    required property var modelData
+                    width: parent ? parent.width : 0
+                    title: root.pretty(modelData.Id)
+                    subtitle: (modelData.Description || "") + " · " + root.stateText(modelData)
+                    iconName: modelData.ActiveState === "failed" ? "error_outline" : "radio_button_checked"
+                    iconColor: modelData.ActiveState === "failed" ? Theme.error : Theme.primary
+
+                    Row {
+                        anchors.verticalCenter: parent ? parent.verticalCenter : undefined
+                        spacing: Theme.spacingXS
+                        DButton {
+                            text: "Neu starten"
+                            variant: "text"
+                            onClicked: root.act("restart", other.modelData.Id)
+                        }
+                        DButton {
+                            text: "Protokoll"
+                            variant: "text"
+                            onClicked: root.journal(other.modelData.Id)
+                        }
+                    }
+                }
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "line_start"
+            title: "Autostart"
+            settingKey: "alpeServiceAutostart"
+
+            SettingsNavRow {
+                title: I18n.tr("Autostart apps")
+                hint: "Programme und Befehle, die mit der Sitzung starten (~/.config/autostart)"
+                iconName: "line_start"
+                onClicked: keyboard => root.parentModal?.navigateTo("autostart", keyboard)
+            }
+        }
+    }
+}
diff --git a/quickshell/Modules/Settings/AlpeShortcutsTab.qml b/quickshell/Modules/Settings/AlpeShortcutsTab.qml
new file mode 100644
index 000000000..b5ade2090
--- /dev/null
+++ b/quickshell/Modules/Settings/AlpeShortcutsTab.qml
@@ -0,0 +1,633 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import Quickshell
+import Quickshell.Wayland
+import qs.Common
+import qs.Services
+import qs.DCommon.Widgets
+import qs.Modules.Settings.Widgets
+
+// Alpe: Tastenkürzel unter KWin. Alle globalen Kürzel aus kglobalaccel (KWin, Alpe, Plasma,
+// Programme) an einem Ort; ändern wie in KDEs Dialog über setForeignShortcutKeys. Ersetzt unter
+// KWin die Seite des Ursprungsprojekts, die nur Niri und Hyprland kennt.
+//
+// Alpe: Die Liste ist eine ListView (nur sichtbare Zeilen entstehen). Vorher stand jede der
+// über 300 Aktionen als SettingsRow in einer SettingsGroup; die legt bei jeder neuen Zeile alle
+// Zeilen neu aus und baut ihre Hintergründe neu – bei jedem Tastendruck in der Suche, was die
+// Shell minutenlang festhielt. Die Suche wartet jetzt 150 ms. Während der Aufnahme hält ein
+// ShortcutInhibitor (keyboard-shortcuts-inhibit, von KWin unterstützt) KWins Kürzel an, sonst
+// löste Meta+… die bestehende Aktion aus, statt hier anzukommen. Neu: Kürzel für Programme und
+// eigene Befehle anlegen, wie «Neu hinzufügen» in KDEs Systemeinstellungen.
+Item {
+    id: root
+
+    property var parentModal: null
+
+    property var info: null
+    property bool loading: false
+    property string filter: ""
+    property string filterText: ""
+    property string group: ""
+    // Aufnahme: Zeile {component, action, componentName, actionName, keys} oder neues Kürzel {isNew, spec}
+    property var capture: null
+    // Kombination, die schon belegt ist: {combo, owner, target}
+    property var conflict: null
+    property string message: ""
+
+    // Neues Kürzel
+    property string newKind: "app"           // app | command
+    property var apps: []                    // [{id, name}]
+    property string newApp: ""               // Desktop-Datei-ID
+    property string newName: ""
+    property string newCommand: ""
+
+    // Angezeigte Zeilen (von rebuild() gefüllt, nicht als Bindung: sonst rechnet jede Taste alles neu)
+    property var shown: []
+    property int total: 0
+
+    readonly property string groupCustom: "Eigene Befehle"
+    readonly property string groupApps: "Programme starten"
+
+    AlpeKwinBackend {
+        id: backend
+    }
+
+    readonly property bool inhibiting: inhibitor.active
+
+    ShortcutInhibitor {
+        id: inhibitor
+        window: root.parentModal
+        enabled: root.capture !== null
+    }
+
+    Timer {
+        id: filterDelay
+        interval: 150
+        onTriggered: root.filter = root.filterText
+    }
+
+    // Wer während der Aufnahme weggeht, soll KDEs Kürzel nicht dauerhaft angehalten zurücklassen.
+    Timer {
+        id: captureTimeout
+        interval: 20000
+        onTriggered: {
+            root.endCapture();
+            root.message = "Aufnahme beendet (keine Taste gedrückt).";
+        }
+    }
+
+    function refresh() {
+        loading = true;
+        backend.run(["shortcuts"], result => {
+            loading = false;
+            if (result)
+                info = result;
+        });
+    }
+
+    function loadApps() {
+        backend.run(["apps"], result => {
+            if (result && result.apps)
+                apps = result.apps;
+        });
+    }
+
+    Component.onCompleted: {
+        refresh();
+        loadApps();
+    }
+    Component.onDestruction: {
+        if (capture !== null)
+            backend.run(["block", "off"]);
+    }
+
+    onComponentsChanged: rebuild(true)
+    onFilterChanged: rebuild(false)
+    onGroupChanged: rebuild(false)
+
+    readonly property var components: info ? info.components : []
+    readonly property var groupNames: {
+        const out = [];
+        for (const c of components)
+            if (out.indexOf(groupOf(c)) < 0)
+                out.push(groupOf(c));
+        return out;
+    }
+
+    function groupOf(c) {
+        return c.custom ? groupCustom : c.launch ? groupApps : c.name;
+    }
+
+    function rebuild(keepScroll) {
+        const y = list.contentY - list.originY;
+        const out = [];
+        const needle = filter.trim().toLowerCase();
+        let count = 0;
+        let last = null;
+        for (const c of components) {
+            const g = groupOf(c);
+            if (group !== "" && g !== group)
+                continue;
+            for (const a of c.actions) {
+                count += 1;
+                const keys = a.keys.map(k => keyText(k)).join(", ");
+                // Bei Programmen heisst die Aktion «Starten»: der Name des Programms ist der Titel.
+                const title = c.launch && a.action === "_launch" ? c.name : a.name;
+                if (needle !== "" && (title + " " + a.name + " " + c.name + " " + keys).toLowerCase().indexOf(needle) < 0)
+                    continue;
+                const changed = JSON.stringify(a.keys) !== JSON.stringify(a.defaults);
+                const row = {
+                    "uid": c.component + "\u0001" + a.action,
+                    "group": g,
+                    "component": c.component,
+                    "componentName": c.name,
+                    "action": a.action,
+                    "actionName": title,
+                    "keys": a.keys,
+                    "defaults": a.defaults,
+                    "keyLabel": keys !== "" ? keys : "–",
+                    "changed": changed && !c.launch,
+                    "removable": c.launch === true,
+                    "custom": c.custom === true,
+                    "command": c.command ?? "",
+                    "first": last === null || last.group !== g,
+                    "last": true
+                };
+                if (last !== null && last.group === g)
+                    last.last = false;
+                out.push(row);
+                last = row;
+            }
+        }
+        total = count;
+        shown = out;
+        // Ein neues Modell macht die erste Zeile zur aktuellen (die Bindung -1 geht dabei verloren),
+        // und die aktuelle Zeile bekäme den Fokus.
+        list.currentIndex = -1;
+        if (keepScroll)
+            Qt.callLater(() => list.contentY = Math.min(list.originY + y, list.maximumContentY));
+    }
+
+    function subtitleOf(row) {
+        const parts = [];
+        if (row.group !== row.componentName && !row.custom && row.action !== "_launch")
+            parts.push(row.componentName);
+        if (row.custom && row.command !== "")
+            parts.push(row.command);
+        if (row.changed && row.defaults.length > 0)
+            parts.push("Vorgabe: " + row.defaults.map(k => keyText(k)).join(", "));
+        return parts.join(" · ");
+    }
+
+    // ---------------------------------------------------------------- Tasten
+
+    readonly property int modMask: Qt.ShiftModifier | Qt.ControlModifier | Qt.AltModifier | Qt.MetaModifier
+    readonly property var names: ({
+            [Qt.Key_Escape]: "Esc", [Qt.Key_Tab]: "Tab", [Qt.Key_Backtab]: "Tab", [Qt.Key_Backspace]: "Rücktaste",
+            [Qt.Key_Return]: "Eingabe", [Qt.Key_Enter]: "Eingabe", [Qt.Key_Insert]: "Einfg", [Qt.Key_Delete]: "Entf",
+            [Qt.Key_Pause]: "Pause", [Qt.Key_Print]: "Druck", [Qt.Key_Home]: "Pos1", [Qt.Key_End]: "Ende",
+            [Qt.Key_Left]: "←", [Qt.Key_Up]: "↑", [Qt.Key_Right]: "→", [Qt.Key_Down]: "↓",
+            [Qt.Key_PageUp]: "Bild↑", [Qt.Key_PageDown]: "Bild↓", [Qt.Key_Space]: "Leertaste",
+            [Qt.Key_VolumeDown]: "Leiser", [Qt.Key_VolumeUp]: "Lauter", [Qt.Key_VolumeMute]: "Stumm",
+            [Qt.Key_MediaPlay]: "Wiedergabe", [Qt.Key_MediaTogglePlayPause]: "Wiedergabe/Pause", [Qt.Key_MediaStop]: "Stopp",
+            [Qt.Key_MediaPrevious]: "Zurück", [Qt.Key_MediaNext]: "Weiter", [Qt.Key_MonBrightnessUp]: "Heller",
+            [Qt.Key_MonBrightnessDown]: "Dunkler", [Qt.Key_Calculator]: "Rechner", [Qt.Key_Launch0]: "Start 0",
+            [Qt.Key_MicMute]: "Mikrofon aus", [Qt.Key_PowerOff]: "Ein/Aus", [Qt.Key_Sleep]: "Ruhezustand"
+        })
+
+    function keyText(combo) {
+        combo = combo | 0;
+        if (combo === 0)
+            return "";
+        const parts = [];
+        if (combo & Qt.MetaModifier)
+            parts.push("Meta");
+        if (combo & Qt.ControlModifier)
+            parts.push("Strg");
+        if (combo & Qt.AltModifier)
+            parts.push("Alt");
+        if (combo & Qt.ShiftModifier)
+            parts.push("Umschalt");
+        const key = combo & ~(modMask | Qt.KeypadModifier);
+        let name = names[key];
+        if (name === undefined) {
+            if (key >= Qt.Key_F1 && key <= Qt.Key_F35)
+                name = "F" + (key - Qt.Key_F1 + 1);
+            else if (key >= 0x20 && key < 0x7f)
+                name = String.fromCharCode(key).toUpperCase();
+            else if (key >= 0xa0 && key <= 0xff)
+                name = String.fromCharCode(key).toUpperCase();
+            else
+                name = "0x" + key.toString(16);
+        }
+        parts.push(name);
+        return parts.join("+");
+    }
+
+    function owner(combo, except) {
+        for (const c of components)
+            for (const a of c.actions)
+                if (a.keys.indexOf(combo) >= 0 && !(c.component === except.component && a.action === except.action))
+                    return {
+                        "component": c.component,
+                        "componentName": c.name,
+                        "action": a.action,
+                        "actionName": c.launch && a.action === "_launch" ? c.name : a.name,
+                        "keys": a.keys
+                    };
+        return null;
+    }
+
+    function setKeys(target, keys, then) {
+        backend.run(["shortcut-set", JSON.stringify({
+                "component": target.component,
+                "action": target.action,
+                "componentName": target.componentName,
+                "actionName": target.actionName,
+                "keys": keys
+            })], () => {
+            if (then)
+                then();
+            else
+                refresh();
+        });
+    }
+
+    // Kombination einer Zeile oder einem neuen Kürzel geben.
+    function assign(target, combo) {
+        if (target.isNew) {
+            backend.run(["shortcut-new", JSON.stringify(Object.assign({}, target.spec, {
+                    "keys": [combo]
+                }))], result => {
+                if (result && result.ok) {
+                    message = "«" + target.actionName + "» startet jetzt mit " + keyText(combo) + ".";
+                    newName = "";
+                    newCommand = "";
+                } else {
+                    message = "Konnte das Kürzel nicht anlegen" + (result && result.error ? ": " + result.error : ".");
+                }
+                refresh();
+            });
+            return;
+        }
+        // Neue Kombination ersetzt die erste; eine zweite bleibt.
+        const rest = target.keys.filter((k, i) => i > 0 && k !== combo);
+        setKeys(target, [combo].concat(rest));
+        message = target.actionName + ": " + keyText(combo);
+    }
+
+    function remove(row) {
+        backend.run(["shortcut-remove", JSON.stringify({
+                "component": row.component,
+                "action": row.action
+            })], () => refresh());
+        message = row.custom ? "«" + row.actionName + "» entfernt." : row.actionName + ": kein Kürzel mehr";
+    }
+
+    function beginCapture(row) {
+        conflict = null;
+        message = "";
+        capture = row;
+        backend.run(["block", "on"]);
+        captureTimeout.restart();
+        catcher.forceActiveFocus();
+    }
+
+    function endCapture() {
+        captureTimeout.stop();
+        if (capture !== null)
+            backend.run(["block", "off"]);
+        capture = null;
+    }
+
+    function captured(combo) {
+        const target = capture;
+        endCapture();
+        const other = owner(combo, target);
+        if (other) {
+            conflict = {
+                "combo": combo,
+                "owner": other,
+                "target": target
+            };
+            return;
+        }
+        assign(target, combo);
+    }
+
+    function resolveConflict(take) {
+        const c = conflict;
+        conflict = null;
+        if (!take || !c)
+            return;
+        setKeys(c.owner, c.owner.keys.filter(k => k !== c.combo), () => root.assign(c.target, c.combo));
+        message = keyText(c.combo) + " gehört jetzt zu «" + c.target.actionName + "», nicht mehr zu «" + c.owner.actionName + "».";
+    }
+
+    readonly property var newApplication: apps.find(a => a.id === newApp) ?? null
+    readonly property bool newReady: newKind === "app" ? newApplication !== null : newName.trim() !== "" && newCommand.trim() !== ""
+
+    function captureNew() {
+        if (!newReady)
+            return;
+        if (newKind === "app")
+            beginCapture({
+                "isNew": true,
+                "component": newApplication.id,
+                "action": "_launch",
+                "componentName": newApplication.name,
+                "actionName": newApplication.name,
+                "keys": [],
+                "spec": {
+                    "kind": "app",
+                    "id": newApplication.id,
+                    "name": newApplication.name
+                }
+            });
+        else
+            beginCapture({
+                "isNew": true,
+                "component": "",
+                "action": "_launch",
+                "componentName": newName.trim(),
+                "actionName": newName.trim(),
+                "keys": [],
+                "spec": {
+                    "kind": "command",
+                    "name": newName.trim(),
+                    "command": newCommand.trim()
+                }
+            });
+    }
+
+    // Unsichtbarer Fänger für die Aufnahme
+    Item {
+        id: catcher
+        focus: root.capture !== null
+        Keys.onPressed: event => {
+            event.accepted = true;
+            const k = event.key;
+            if (k === Qt.Key_Shift || k === Qt.Key_Control || k === Qt.Key_Alt || k === Qt.Key_Meta || k === Qt.Key_Super_L || k === Qt.Key_Super_R || k === Qt.Key_AltGr || k === Qt.Key_unknown)
+                return;
+            const mods = event.modifiers & root.modMask;
+            if (k === Qt.Key_Escape && mods === 0) {
+                root.endCapture();
+                return;
+            }
+            if ((k === Qt.Key_Backspace || k === Qt.Key_Delete) && mods === 0) {
+                const target = root.capture;
+                root.endCapture();
+                if (target.isNew)
+                    return;
+                root.setKeys(target, []);
+                root.message = target.actionName + ": kein Kürzel mehr";
+                return;
+            }
+            // Buchstaben als Grossbuchstaben-Code wie Qt; Umschalt+Tab kommt als Backtab.
+            const key = k === Qt.Key_Backtab ? Qt.Key_Tab : k;
+            root.captured(mods | key);
+        }
+        onActiveFocusChanged: if (!activeFocus && root.capture !== null) root.endCapture()
+    }
+
+    // Alpe: Suche und Bereich stehen fest über der Liste, nicht in ihrem Kopf. In der Liste
+    // nahm ihr Fokusbereich dem Suchfeld nach jedem Buchstaben den Fokus (neues Modell → neue
+    // aktuelle Zeile); ausserhalb kann er das nicht.
+    Column {
+        id: toolbar
+
+        width: list.columnWidth
+        anchors.top: parent.top
+        anchors.horizontalCenter: parent.horizontalCenter
+        topPadding: Theme.spacingXS + SettingsMetrics.focusGutter
+        bottomPadding: SettingsMetrics.cardGap
+
+        SettingsCard {
+            width: parent.width
+            iconName: "keyboard"
+            title: "Tastenkürzel"
+            settingKey: "alpeShortcuts"
+            tags: ["tastenkürzel", "shortcuts", "keybinds", "kwin", "kglobalaccel"]
+
+            SettingsNoteRow {
+                visible: root.info !== null && !root.info.available
+                text: "Der Dienst für globale Kürzel (kglobalaccel) antwortet nicht."
+            }
+
+            SettingsTextFieldRow {
+                text: "Suchen"
+                placeholderText: "Aktion, Bereich oder Taste, etwa «Meta+S»"
+                value: root.filterText
+                onValueEdited: value => {
+                    root.filterText = value;
+                    filterDelay.restart();
+                }
+            }
+
+            SettingsDropdownRow {
+                text: "Bereich"
+                enableFuzzySearch: true
+                options: ["Alle Bereiche"].concat(root.groupNames)
+                currentValue: root.group === "" ? "Alle Bereiche" : root.group
+                onValueChanged: value => root.group = value === "Alle Bereiche" ? "" : value
+            }
+
+            SettingsRow {
+                visible: root.capture !== null
+                title: root.capture ? "Taste drücken für «" + root.capture.actionName + "»" : ""
+                subtitle: "Esc bricht ab" + (root.capture && !root.capture.isNew ? ", Rücktaste entfernt das Kürzel" : "") + ". KDEs Kürzel ruhen so lange."
+                iconName: "keyboard_alt"
+                active: true
+            }
+
+            SettingsRow {
+                visible: root.conflict !== null
+                title: root.conflict ? root.keyText(root.conflict.combo) + " ist schon vergeben" : ""
+                subtitle: root.conflict ? "an «" + root.conflict.owner.actionName + "» (" + root.conflict.owner.componentName + ")" : ""
+                iconName: "warning"
+                iconColor: Theme.warning
+
+                body: Flow {
+                    width: parent.width
+                    spacing: Theme.spacingS
+                    DButton {
+                        text: "Trotzdem übernehmen"
+                        onClicked: root.resolveConflict(true)
+                    }
+                    DButton {
+                        text: "Abbrechen"
+                        variant: "text"
+                        onClicked: root.resolveConflict(false)
+                    }
+                }
+            }
+
+            SettingsNoteRow {
+                visible: root.message !== ""
+                text: root.message
+            }
+
+            SettingsNoteRow {
+                visible: root.loading && root.info === null
+                text: "Lese die Kürzel …"
+            }
+        }
+    }
+
+    DListView {
+        id: list
+
+        readonly property real columnWidth: Math.min(SettingsMetrics.contentMaxWidth, width - SettingsMetrics.focusGutter * 2)
+
+        anchors.top: toolbar.bottom
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.bottom: parent.bottom
+        clip: true
+        keyNavigationEnabled: false
+        // Sonst gibt die ListView jeder neuen Zeile den Fokus und nimmt ihn dem Suchfeld.
+        currentIndex: -1
+        spacing: SettingsMetrics.groupGap
+        model: root.shown
+
+        header: Item {
+            width: list.width
+            height: headerColumn.height + SettingsMetrics.cardGap
+
+            Column {
+                id: headerColumn
+                width: list.columnWidth
+                anchors.horizontalCenter: parent.horizontalCenter
+                topPadding: SettingsMetrics.focusGutter
+                spacing: SettingsMetrics.cardGap
+
+                SettingsCard {
+                    width: parent.width
+                    iconName: "add"
+                    title: "Neues Kürzel"
+                    settingKey: "alpeShortcutNew"
+                    tags: ["neu", "befehl", "programm", "starten", "eigenes kürzel"]
+
+                    SettingsDropdownRow {
+                        text: "Art"
+                        options: ["Programm starten", "Befehl ausführen"]
+                        currentValue: root.newKind === "app" ? "Programm starten" : "Befehl ausführen"
+                        onValueChanged: value => root.newKind = value === "Programm starten" ? "app" : "command"
+                    }
+
+                    SettingsDropdownRow {
+                        visible: root.newKind === "app"
+                        text: "Programm"
+                        enableFuzzySearch: true
+                        emptyText: root.apps.length === 0 ? "Lese die Programme …" : "Programm wählen"
+                        options: root.apps.map(a => a.name)
+                        currentValue: root.newApplication ? root.newApplication.name : ""
+                        onValueChanged: value => {
+                            const hit = root.apps.find(a => a.name === value);
+                            root.newApp = hit ? hit.id : "";
+                        }
+                    }
+
+                    SettingsTextFieldRow {
+                        visible: root.newKind === "command"
+                        text: "Name"
+                        placeholderText: "etwa «Terminal»"
+                        value: root.newName
+                        onValueEdited: value => root.newName = value
+                    }
+
+                    SettingsTextFieldRow {
+                        visible: root.newKind === "command"
+                        text: "Befehl"
+                        placeholderText: "etwa «kitty --single-instance»"
+                        value: root.newCommand
+                        onValueEdited: value => root.newCommand = value
+                    }
+
+                    SettingsRow {
+                        title: "Taste festlegen"
+                        subtitle: root.newReady ? "Danach die gewünschte Kombination drücken." : root.newKind === "app" ? "Zuerst ein Programm wählen." : "Zuerst Name und Befehl eingeben."
+                        iconName: "keyboard_alt"
+
+                        DButton {
+                            anchors.verticalCenter: parent ? parent.verticalCenter : undefined
+                            text: "Aufnehmen"
+                            iconName: "radio_button_checked"
+                            variant: "tonal"
+                            enabled: root.newReady && root.capture === null
+                            onClicked: root.captureNew()
+                        }
+                    }
+                }
+
+                SettingsSectionLabel {
+                    width: parent.width
+                    text: root.shown.length === root.total ? root.total + " Aktionen" : root.shown.length + " von " + root.total + " Aktionen"
+                }
+            }
+        }
+
+        delegate: Item {
+            id: entry
+
+            required property var modelData
+            required property int index
+
+            width: list.width
+            height: entryColumn.height
+
+            Column {
+                id: entryColumn
+                width: list.columnWidth
+                anchors.horizontalCenter: parent.horizontalCenter
+
+                // Bereichsname über der ersten Zeile eines Bereichs
+                SettingsSectionLabel {
+                    width: parent.width
+                    visible: entry.modelData.first && root.group === ""
+                    text: entry.modelData.group
+                }
+
+                SettingsRow {
+                    id: row
+                    width: parent.width
+                    inGroup: true
+                    topRadius: entry.modelData.first ? Theme.groupedListOuterRadius : SettingsMetrics.groupInnerRadius
+                    bottomRadius: entry.modelData.last ? Theme.groupedListOuterRadius : SettingsMetrics.groupInnerRadius
+                    dividerBefore: !entry.modelData.first
+                    title: entry.modelData.actionName
+                    singleLineTitle: true
+                    subtitle: root.subtitleOf(entry.modelData)
+                    trailingBadge: entry.modelData.keyLabel
+                    clickable: true
+                    active: root.capture !== null && root.capture.action === entry.modelData.action && root.capture.component === entry.modelData.component
+                    onClicked: root.beginCapture(entry.modelData)
+
+                    DButton {
+                        visible: entry.modelData.changed
+                        anchors.verticalCenter: parent ? parent.verticalCenter : undefined
+                        text: "Vorgabe"
+                        iconName: "restart_alt"
+                        variant: "text"
+                        onClicked: root.setKeys(entry.modelData, entry.modelData.defaults)
+                    }
+
+                    DActionButton {
+                        visible: entry.modelData.removable
+                        anchors.verticalCenter: parent ? parent.verticalCenter : undefined
+                        iconName: "delete"
+                        iconColor: Theme.surfaceVariantText
+                        tooltipText: entry.modelData.custom ? "Befehl und Kürzel entfernen" : "Kürzel entfernen"
+                        onClicked: root.remove(entry.modelData)
+                    }
+                }
+            }
+        }
+
+        footer: Item {
+            width: list.width
+            height: SettingsMetrics.pagePaddingV
+        }
+    }
+}
diff --git a/quickshell/Modules/Settings/AlpeSportTab.qml b/quickshell/Modules/Settings/AlpeSportTab.qml
new file mode 100644
index 000000000..d148e6ae2
--- /dev/null
+++ b/quickshell/Modules/Settings/AlpeSportTab.qml
@@ -0,0 +1,491 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import qs.Common
+import qs.Services
+import qs.DCommon.Widgets
+import qs.Modules.DDash
+import qs.Modules.Settings.Widgets
+
+// Alpe: Einstellungen des Sport-Plugins an einem Ort. Wettbewerbe (an/aus wie im Dashboard,
+// dazu die Reihenfolge), Favoriten, Mitteilungen und Leiste, Streamingdienste je Wettbewerb,
+// Nachladen, Zwischenspeicher. Gespeichert wird in den Plugin-Daten (plugin_settings.json →
+// alpeSport), die Schalter der Wettbewerbe in den Dashboard-Optionen (eine Quelle für beide).
+Item {
+    id: root
+
+    property var parentModal: null
+
+    readonly property string pluginId: "alpeSport"
+    readonly property string entryId: "plugin_alpeSport"
+    readonly property string pluginDir: PluginService.getPluginPath ? PluginService.getPluginPath(pluginId) : ""
+    readonly property bool available: pluginDir !== ""
+    readonly property string helper: pluginDir + "/sport"
+
+    property var store: ({})
+    property var leagues: []
+    property var cache: null
+    property string streamLeague: ""
+    property string draftName: ""
+    property string draftUrl: ""
+    property string testState: ""
+
+    readonly property var order: store.order ?? []
+    readonly property var orderedLeagues: {
+        const list = leagues.slice();
+        const rank = id => {
+            const at = order.indexOf(id);
+            return at < 0 ? 1000 + leagues.findIndex(l => l.id === id) : at;
+        };
+        return list.sort((a, b) => rank(a.id) - rank(b.id));
+    }
+    readonly property var favorites: store.favorites ?? []
+    readonly property var favoriteNames: store.favoriteNames ?? ({})
+    readonly property var streams: store.streams ?? ({})
+
+    function load() {
+        store = SettingsData.getPluginSettingsForPlugin ? (SettingsData.getPluginSettingsForPlugin(pluginId) ?? {}) : {};
+    }
+
+    function save(key, value) {
+        PluginService.savePluginData(pluginId, key, value);
+        load();
+    }
+
+    function optionKey(id) {
+        return "liga_" + id.replace(/\./g, "_");
+    }
+
+    function leagueEnabled(league) {
+        const stored = DashRegistry.storedOptions ? DashRegistry.storedOptions(entryId) : {};
+        const key = optionKey(league.id);
+        return key in stored ? stored[key] === true || stored[key] === "true" : league["default"] !== false;
+    }
+
+    function setLeague(league, on) {
+        DashRegistry.setOption(entryId, optionKey(league.id), on);
+    }
+
+    function move(id, step) {
+        const ids = orderedLeagues.map(l => l.id);
+        const at = ids.indexOf(id);
+        const to = at + step;
+        if (at < 0 || to < 0 || to >= ids.length)
+            return;
+        ids.splice(at, 1);
+        ids.splice(to, 0, id);
+        save("order", ids);
+    }
+
+    function removeFavorite(key) {
+        save("favorites", favorites.filter(k => k !== key));
+    }
+
+    function pickStreamLeague(id) {
+        streamLeague = id;
+        draftName = streams[id]?.name ?? "";
+        draftUrl = streams[id]?.url ?? "";
+    }
+
+    function saveStream() {
+        if (streamLeague === "" || draftUrl.trim() === "")
+            return;
+        let url = draftUrl.trim();
+        if (!/^https?:\/\//i.test(url))
+            url = "https://" + url;
+        const copy = Object.assign({}, streams);
+        copy[streamLeague] = {
+            "name": draftName.trim() || url.replace(/^https?:\/\/(www\.)?/i, "").split("/")[0],
+            "url": url
+        };
+        draftUrl = url;
+        save("streams", copy);
+    }
+
+    function removeStream(id) {
+        const copy = Object.assign({}, streams);
+        delete copy[id];
+        save("streams", copy);
+        if (id === streamLeague)
+            pickStreamLeague(id);
+    }
+
+    function leagueName(id) {
+        return leagues.find(l => l.id === id)?.name ?? id;
+    }
+
+    function sportName(sport) {
+        return ({
+                "hockey": "Eishockey",
+                "soccer": "Fussball",
+                "basketball": "Basketball"
+            })[sport] ?? sport;
+    }
+
+    function size(bytes) {
+        return bytes >= 1048576 ? (bytes / 1048576).toFixed(1) + " MB" : Math.round(bytes / 1024) + " KB";
+    }
+
+    function run(args, done) {
+        if (!available)
+            return;
+        Proc.runCommand("alpe-sport-" + args[0], ["python3", "-I", helper].concat(args), (output, code) => {
+            try {
+                done(JSON.parse(output));
+            } catch (e) {}
+        }, 0, 30000);
+    }
+
+    Component.onCompleted: {
+        load();
+        run(["leagues"], answer => {
+            root.leagues = answer.leagues ?? [];
+            if (root.streamLeague === "" && root.leagues.length > 0)
+                root.pickStreamLeague(root.leagues[0].id);
+        });
+        run(["cache"], answer => root.cache = answer);
+    }
+
+    Connections {
+        target: PluginService
+
+        function onPluginDataChanged(changedId) {
+            if (changedId === root.pluginId)
+                root.load();
+        }
+    }
+
+    SettingsPage {
+        SettingsCard {
+            width: parent.width
+            iconName: "sports_soccer"
+            title: "Sport"
+            settingKey: "alpeSport"
+            tags: ["sport", "fussball", "eishockey", "nba", "wettbewerbe"]
+
+            SettingsNoteRow {
+                visible: !root.available
+                text: "Das Plugin «Sport» ist nicht aktiv. Einschalten unter Plugins oder mit «alpe plugins»."
+            }
+
+            SettingsRow {
+                visible: root.available
+                title: "Wettbewerbe ein- und ausschalten, Reihenfolge festlegen"
+                subtitle: "Gilt für den Sport-Tab, die Karte «Sport heute» und die Mitteilungen. Pfeile ändern die Reihenfolge in der Leiste links."
+                iconName: "info"
+            }
+
+            Repeater {
+                model: root.orderedLeagues
+
+                SettingsToggleRow {
+                    id: leagueRow
+
+                    required property var modelData
+                    required property int index
+
+                    width: parent ? parent.width : 0
+                    text: modelData.name
+                    description: modelData.country + (modelData.kind === "cup" ? " · Cup" : modelData.kind === "national" ? " · Länderspiele" : "")
+                    checked: root.leagueEnabled(modelData)
+                    onToggled: checked => root.setLeague(modelData, checked)
+
+                    accessory: [
+                        DActionButton {
+                            iconName: "arrow_upward"
+                            iconColor: Theme.surfaceVariantText
+                            enabled: leagueRow.index > 0
+                            opacity: enabled ? 1 : 0.3
+                            tooltipText: "Nach oben"
+                            onClicked: root.move(leagueRow.modelData.id, -1)
+                        },
+                        DActionButton {
+                            iconName: "arrow_downward"
+                            iconColor: Theme.surfaceVariantText
+                            enabled: leagueRow.index < root.orderedLeagues.length - 1
+                            opacity: enabled ? 1 : 0.3
+                            tooltipText: "Nach unten"
+                            onClicked: root.move(leagueRow.modelData.id, 1)
+                        }
+                    ]
+                }
+            }
+
+            SettingsRow {
+                visible: root.order.length > 0
+                title: "Reihenfolge zurücksetzen"
+                iconName: "restart_alt"
+
+                DButton {
+                    anchors.verticalCenter: parent.verticalCenter
+                    text: "Zurücksetzen"
+                    variant: "tonal"
+                    onClicked: root.save("order", [])
+                }
+            }
+        }
+
+        SettingsCard {
+            width: parent.width
+            iconName: "star"
