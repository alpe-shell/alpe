+
+    readonly property var presets: [["Stunden", "%H"], ["Minuten", "%M"], ["Uhrzeit", "%H:%M"], ["Datum", "%A, %d. %B"], ["Datum kurz", "%d.%m.%Y"], ["Wochentag", "%A"], ["Begrüssung", "Hallo $USER"]]
