+        for (const line of text.split("\n")) {
+            const cut = line.indexOf("=");
+            if (cut < 0)
+                continue;
+            const value = line.slice(cut + 1);
+            if (value === "") {
+                out[line.slice(0, cut)] = "";
+                continue;
+            }
+            const active = value.replace(/\\,/g, "\u0001").split(",")[0].replace(/\u0001/g, ",");
