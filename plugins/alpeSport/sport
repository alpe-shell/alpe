    """Logo-Adresse. Bis 1.10.3 lief das ueber den Bildverkleinerer von ESPN (combiner); der antwortet
    fuer noch nicht verkleinerte Bilder teils sehr langsam. Die Originale (500 px) liegen statisch im
    CDN; die Oberflaeche verkleinert selbst."""
    return href or ""


LOGO_WAIT = 2.0          # so lange wartet eine Abfrage hoechstens auf fehlende Logos (Sekunden)


def _load_logo(url, path):
    started = time.time()
    try:
        payload = http_get(url)
        if payload[:4] != b"\x89PNG" and payload[:3] != b"\xff\xd8\xff" and payload[:4] != b"RIFF":
            raise ValueError("kein Bild")
        _write_atomic(path, payload)
        if time.time() - started > 5:
            log("Logo langsam %.1f s %s" % (time.time() - started, url))
    except (urllib.error.URLError, OSError, ValueError) as error:
        log("Logo-Fehler nach %.1f s: %s %s" % (time.time() - started, getattr(error, "reason", error), url))
        try:
            open(path + ".none", "w").close()       # nicht bei jedem Aufruf erneut versuchen
        except OSError:
            pass


def _spawn_logo_loader(wanted):
    """Restliche Logos in einem eigenen, abgekoppelten Prozess holen: Die Abfrage antwortet sofort,
    das naechste Nachladen hat die Bilder. Der Kindprozess erbt die Ausgabe nicht, sonst wartete die
    Shell auf dessen Ende."""
    import subprocess
    try:
        fd, listing = tempfile.mkstemp(dir=cache_dir(), prefix="logos-", suffix=".json")
        with os.fdopen(fd, "w") as handle:
            json.dump(wanted, handle)
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "logos", listing],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         close_fds=True, start_new_session=True)
    except OSError as error:
        log("Logo-Lader nicht gestartet: %s" % error)


def fetch_logos(objects, wait=LOGO_WAIT):
    """objects: Liste von dicts mit "logoUrl"; setzt "logo" auf eine lokale Datei (oder "").
    Wartet hoechstens `wait` Sekunden; was dann fehlt, holt ein Hintergrundprozess."""
    import threading
    folder = cache_dir("logos")
    wanted = {}
    for obj in objects:
        url = obj.pop("logoUrl", "")
        if not url:
            obj["logo"] = ""
            continue
        path = os.path.join(folder, _key(url) + ".png")
        obj["logo"] = path
        if not os.path.exists(path) and not os.path.exists(path + ".none"):
            wanted[url] = path
    if wanted:
        items = list(wanted.items())
        quick, rest = items[:16], items[16:]
        threads = [threading.Thread(target=_load_logo, args=item, daemon=True) for item in quick]
        for thread in threads:
            thread.start()
        deadline = time.time() + wait
        for thread in threads:
            thread.join(max(0, deadline - time.time()))
        rest += [(url, path) for url, path in quick if not os.path.exists(path) and not os.path.exists(path + ".none")]
        if rest:
            _spawn_logo_loader(dict(rest))
    for obj in objects:
        if obj.get("logo") and not os.path.exists(obj["logo"]):
            obj["logo"] = ""


def command_logos(listing):
    try:
        with open(listing) as handle:
            wanted = json.load(handle)
    finally:
        try:
            os.unlink(listing)
        except OSError:
            pass
    with ThreadPoolExecutor(max_workers=6) as pool:
        list(pool.map(lambda item: _load_logo(*item), wanted.items()))


def parse_time(text):
    """ESPN: 2026-11-15T13:00Z, SIHF: 2026-11-15T15:45:00+01:00 -> aware datetime (UTC)."""
    if not text:
        return None
    text = text.strip().replace("Z", "+00:00")
    if re.match(r".*T\d\d:\d\d\+", text):
        text = text.replace("+", ":00+", 1)
    try:
        value = datetime.fromisoformat(text)
    except ValueError:
        return None
    if value.tzinfo is None:
        value = value.replace(tzinfo=timezone.utc)
    return value.astimezone(timezone.utc)


def iso(value):
    return value.strftime("%Y-%m-%dT%H:%M:%SZ") if value else ""


def local_date(value):
    return value.astimezone().date() if value else None


def today():
    forced = os.environ.get("ALPE_SPORT_TODAY")
    return date.fromisoformat(forced) if forced else datetime.now().astimezone().date()


def num(text, default=None):
    try:
        return float(str(text).replace("%", "").replace("+", "").strip())
    except (TypeError, ValueError):
        return default


def german_round(text):
    if not text:
        return ""
    low = text.strip().lower().replace("-", " ")
    for pattern, replacement in GERMAN_ROUNDS:
        if re.search(pattern, low):
            return re.sub(pattern, replacement, low) if "\\1" in replacement else replacement
    return text.strip()


def surname(full):
    """SIHF-Namen stehen als «Nachname Vorname»; fuer Ereignisse genuegt der Nachname."""
    parts = (full or "").split()
    return " ".join(parts[:-1]) if len(parts) > 1 else (full or "")


