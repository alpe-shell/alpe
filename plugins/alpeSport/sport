def ttl_for(day, matches):
    if any(m["status"] == "live" for m in matches):
        return 30
    now = today()
    if day == now:
        soon = [parse_time(m["start"]) for m in matches if m["status"] == "pre"]
        upcoming = [s for s in soon if s and s - datetime.now(timezone.utc) < timedelta(minutes=20)]
        return 60 if upcoming else 180
    if day > now:
        return 900
    return 6 * 3600


def league_day(fetch, league_id, day, age=None):
    league = LEAGUE[league_id]
    first, last = day - timedelta(days=1), day + timedelta(days=1)
    if age is None:
        age = 30 if abs((day - today()).days) <= 1 else (900 if day > today() else 6 * 3600)
    if league["source"] == "sihf":
        matches, logo = sihf_results(fetch, first, last, age), ""
    elif league["source"] == "sihf-nati":
        matches, logo = sihf_national(fetch, first, last, 300 if age < 30 else 1800), ""
    elif league["source"] == "espn-team":
        matches, logo = espn_national(fetch, league["path"], first, last, 120 if age <= 30 else 1800), ""
    else:
        # ESPN-Tage laufen nach US-Ostküstenzeit: ein Spiel am Ortstag D steht unter D-1 oder D
        matches, logo = espn_scoreboard(fetch, league_id, espn_keys(day - timedelta(days=1), day), age)
    matches = [m for m in matches if local_date(parse_time(m["start"])) == day]
    return matches, logo


