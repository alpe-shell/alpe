def zone_for(note):
    if not note:
        return None
    text = (note.get("description") or "").strip()
    low = text.lower()
    if not text:
        return None
    if "champions" in low:
        kind = "cl"
        label = "Champions League" + (" (Quali)" if "qual" in low else "")
    elif "conference" in low:
        kind = "ecl"
        label = "Conference League" + (" (Quali)" if "qual" in low else "")
    elif "europa" in low:
        kind = "el"
        label = "Europa League" + (" (Quali)" if "qual" in low else "")
    elif "relegation" in low and ("playoff" in low or "play-off" in low or "play off" in low):
        kind, label = "relplay", "Relegation"
    elif "relegation" in low:
        kind, label = "rel", "Abstieg"
    elif "promotion" in low or "playoff" in low:
        kind, label = "up", "Playoffs"
    else:
        kind, label = "other", text
    return {"kind": kind, "label": label, "color": note.get("color", "")}


def espn_stats(entry):
    stats = {}
    for item in entry.get("stats") or []:
        value = item.get("displayValue")
        if value is None:
            value = item.get("value")
        for key in (item.get("name"), item.get("type"), item.get("abbreviation")):
            if key:
                stats.setdefault(re.sub(r"[^a-z0-9]", "", str(key).lower()), "" if value is None else str(value))
    return stats


def espn_standings(fetch, league_id, max_age):
    league = LEAGUE[league_id]
    data = fetch.json(ESPN_STANDINGS + league["path"] + "/standings", max_age) or {}
    children = data.get("children") or ([data] if data.get("standings") else [])
    groups = []
    teams = []
    for child in children:
        entries = (child.get("standings") or {}).get("entries") or []
        rows = []
        for entry in entries:
            stats = espn_stats(entry)
            team = espn_team({"team": entry.get("team") or {}})
            teams.append(team)
            if league["sport"] == "basketball":
                rank = int(num(stats.get("playoffseed"), 0) or 0)
                cells = {"w": stats.get("wins", ""), "l": stats.get("losses", ""),
                         "pct": stats.get("winpercent", ""), "gb": stats.get("gamesbehind", ""),
                         "streak": stats.get("streak", ""), "l10": stats.get("lasttengames", "")}
                zone = {"kind": "up", "label": "Playoffs"} if 0 < rank <= 6 else \
                       {"kind": "playin", "label": "Play-in"} if 0 < rank <= 10 else None
            else:
                rank = int(num(stats.get("rank"), 0) or 0)
                gd = stats.get("pointdifferential", "")
                cells = {"gp": stats.get("gamesplayed", ""), "w": stats.get("wins", ""), "d": stats.get("ties", ""),
                         "l": stats.get("losses", ""),
                         "goals": "%s:%s" % (stats.get("pointsfor", ""), stats.get("pointsagainst", "")),
                         "gd": gd, "pts": stats.get("points", "")}
                zone = zone_for(entry.get("note"))
            rows.append({"rank": rank, "team": team, "cells": cells, "zone": zone})
        rows.sort(key=lambda r: (r["rank"] or 999, r["team"]["name"]))
        for index, row in enumerate(rows):                   # Rang fehlt manchmal
            row["rank"] = row["rank"] or index + 1
        name = child.get("name") or ""
        if len(children) == 1:
            name = ""
        groups.append({"name": name, "rows": rows})
    if not any(g["rows"] for g in groups):
        return None, teams
    if league["sport"] == "basketball":
        columns = [{"key": "w", "label": "S"}, {"key": "l", "label": "N"}, {"key": "pct", "label": "%", "wide": True},
                   {"key": "gb", "label": "GB"}, {"key": "streak", "label": "Serie"}, {"key": "l10", "label": "L10", "wide": True}]
    else:
        columns = [{"key": "gp", "label": "Sp"}, {"key": "w", "label": "S"}, {"key": "d", "label": "U"},
                   {"key": "l", "label": "N"}, {"key": "goals", "label": "Tore", "wide": True},
                   {"key": "gd", "label": "TD"}, {"key": "pts", "label": "Pkt", "strong": True}]
    return {"columns": columns, "groups": groups}, teams


def add_form(table, matches, count=5):
    """Form (S/U/N) aus den beendeten Spielen der geholten Zeitspanne, aelteste zuerst."""
    if not table:
        return
    results = {}
    for match in sorted((m for m in matches if m["status"] == "post"), key=lambda m: m["start"]):
        h, a = num(match["home"]["score"]), num(match["away"]["score"])
        if h is None or a is None:
            continue
        for side, mine, theirs in (("home", h, a), ("away", a, h)):
            letter = "S" if mine > theirs else "N" if mine < theirs else "U"
            if mine == theirs and match["home"].get("penalties"):         # Cup: Penaltyschiessen
                p_home, p_away = num(match["home"]["penalties"], 0), num(match["away"].get("penalties"), 0)
                letter = "S" if (p_home > p_away) == (side == "home") else "N"
            results.setdefault(match[side]["id"], []).append({"r": letter, "match": match["id"]})
    for group in table["groups"]:
        for row in group["rows"]:
            row["form"] = results.get(row["team"]["id"], [])[-count:]


