    german, abbr, code, color = COUNTRIES.get(key, (name or "", (name or "?")[:3].upper(), "", ""))
    return {
        "id": abbr, "name": german, "short": german, "abbr": abbr, "color": color,
        "logoUrl": logo_url("https://a.espncdn.com/i/teamlogos/countries/500/%s.png" % code) if code else "",
        "score": "", "winner": False,
