def stat_pair(label, home, away, percent):
    hv, av = num(home), num(away)
    if percent and hv is not None and av is not None and hv <= 1 and av <= 1 and (hv + av) > 0 and "." in str(home):
        hv, av = hv * 100, av * 100                    # 0.7 -> 70
        home, away = "%d" % round(hv), "%d" % round(av)
    if percent:
        home = (str(home) + " %") if home not in ("", None) and "%" not in str(home) else home
        away = (str(away) + " %") if away not in ("", None) and "%" not in str(away) else away
    return {"label": label, "home": str(home), "away": str(away),
            "hv": hv if hv is not None else 0, "av": av if av is not None else 0, "percent": percent}


def ratio_value(text):
    """"41-88" -> 41 fuer den Balken."""
    match = re.match(r"\s*(\d+)\s*-\s*(\d+)", str(text or ""))
    return float(match.group(1)) if match else num(text)


def espn_team_stats(boxscore, home_id, table):
    by_team = {}
    for team in (boxscore or {}).get("teams") or []:
        tid = str((team.get("team") or {}).get("id", ""))
        by_team[tid] = {s.get("name"): s.get("displayValue", "") for s in team.get("statistics") or []}
    sides = list(by_team.keys())
    if len(sides) != 2:
        return []
    home = by_team.get(home_id) or by_team[sides[0]]
    away = by_team[sides[1]] if home is by_team[sides[0]] else by_team[sides[0]]
    stats = []
    for key, label, percent in table:
        if key in home or key in away:
            pair = stat_pair(label, home.get(key, ""), away.get(key, ""), percent)
            if "-" in key:
                pair["hv"], pair["av"] = ratio_value(home.get(key)) or 0, ratio_value(away.get(key)) or 0
            stats.append(pair)
    return stats


def soccer_event_type(kind, event):
    kind = (kind or "").lower()
    text = (event.get("text") or "").lower()
    if "own" in kind and "goal" in kind:
        return "owngoal"
    if "penalty" in kind and ("miss" in kind or "saved" in kind):
        return "penmiss"
    if "penalty" in kind and event.get("scoringPlay"):
        return "penalty"
    if "goal" in kind or event.get("scoringPlay"):
        return "goal"
    if ("yellow" in kind and "red" in kind) or "second yellow" in text:
        return "yellowred"
    if "yellow" in kind:
        return "yellow"
    if "red" in kind:
        return "red"
    if "substitution" in kind:
        return "sub"
    if kind in ("halftime", "half-time"):
        return "half"
    if kind in ("end-regular-time",):
        return "fulltime"
    if "var" in kind:
        return "var"
    return ""


def minute_sort(display):
    match = re.match(r"\s*(\d+)(?:'\s*\+\s*(\d+))?", display or "")
    if not match:
        return 0
    return int(match.group(1)) * 60 + int(match.group(2) or 0)


def soccer_events(data, home, away):
    events = []
    score = [0, 0]
    names = (home["name"], away["name"])
    for raw in data.get("keyEvents") or []:
        kind = soccer_event_type(((raw.get("type") or {}).get("type") or (raw.get("type") or {}).get("text")), raw)
        if not kind:
            continue
        clock = (raw.get("clock") or {}).get("displayValue", "")
        team_id = str((raw.get("team") or {}).get("id", ""))
        side = "home" if team_id == home["id"] else "away" if team_id == away["id"] else ""
        people = [((p.get("athlete") or {}).get("displayName") or "") for p in raw.get("participants") or []]
        text = raw.get("text") or ""
        item = {"minute": clock, "sort": minute_sort(clock), "type": kind, "side": side,
                "player": people[0] if people else "", "detail": ""}
        if kind in ("goal", "penalty", "owngoal"):
            found = re.search(re.escape(names[0]) + r"\s+(\d+),\s+" + re.escape(names[1]) + r"\s+(\d+)", text)
            if found:
                new = [int(found.group(1)), int(found.group(2))]
                if new[0] > score[0]:
                    item["side"] = "home"
                elif new[1] > score[1]:
                    item["side"] = "away"
                score = new
            else:
                benefit = item["side"]
                if kind == "owngoal":
                    benefit = "away" if side == "home" else "home"
                    item["side"] = benefit
                score[0 if benefit == "home" else 1] += 1
            item["score"] = "%d:%d" % tuple(score)
            if kind == "penalty":
                item["detail"] = "Penalty"
            elif kind == "owngoal":
                item["detail"] = "Eigentor"
            elif len(people) > 1 and people[1]:
                item["detail"] = "Assist: " + people[1]
        elif kind == "sub":
            replaced = re.search(r"\.\s*(.+?) replaces (.+?)(?:\.|$)", text)
            if replaced:
                item["player"], item["detail"] = replaced.group(1).strip(), replaced.group(2).strip()
            elif len(people) > 1:
                item["detail"] = people[1]
        elif kind == "half":
            item.update(side="", player="Pause", score="%d:%d" % tuple(score))
        elif kind == "fulltime":
            item.update(side="", player="Ende 90 Minuten", score="%d:%d" % tuple(score))
        elif kind == "penmiss":
            item["detail"] = "Penalty verschossen"
        elif kind == "var":
            item["detail"] = "Videobeweis"
        events.append(item)
    events.sort(key=lambda e: e["sort"])
    return events


DEPTH = (
    (r"^(G|GK)$", 0), (r"^(SW|CB|CD|CD-L|CD-R|LCB|RCB|D)$", 1), (r"^(LB|RB|LWB|RWB|WB)$", 1),
    (r"^(DM|DM-L|DM-R|CDM)$", 2), (r"^(CM|CM-L|CM-R|LM|RM|M)$", 3), (r"^(AM|AM-L|AM-R|CAM|LW|RW|LAM|RAM)$", 4),
    (r"^(F|CF|CF-L|CF-R|ST|LF|RF|SS|FW)$", 5),
)


def depth_of(position):
    position = (position or "").upper()
    for pattern, depth in DEPTH:
        if re.match(pattern, position):
            return depth
    return 3


def lateral(position):
    """Links (negativ) nach rechts (positiv) aus Sicht des eigenen Tores."""
    position = (position or "").upper()
    if position.endswith("-L") or position in ("LCB", "LCM", "LDM"):
        return -1
    if position.endswith("-R") or position in ("RCB", "RCM", "RDM"):
        return 1
    if position.startswith("L"):                       # LB, LWB, LM, LW, LF: ganz aussen
        return -2
    if position.startswith("R"):
        return 2
    return 0


def formation_lines(starters, formation):
    """Startelf auf Linien verteilen: Torhueter, dann die Linien der Formation (z. B. 4-2-3-1)."""
    keeper = [p for p in starters if depth_of(p["pos"]) == 0][:1]
    field = [p for p in starters if p not in keeper]
    field.sort(key=lambda p: (depth_of(p["pos"]), p.get("place") or 99))
    sizes = [int(x) for x in re.findall(r"\d+", formation or "")]
    if sum(sizes) != len(field):
        sizes = []
        for depth in sorted({depth_of(p["pos"]) for p in field}):
            sizes.append(sum(1 for p in field if depth_of(p["pos"]) == depth))
    lines, at = [], 0
    for size in sizes:
        line = field[at:at + size]
        line.sort(key=lambda p: (lateral(p["pos"]), p.get("place") or 0))
        lines.append(line)
        at += size
    return ([keeper] if keeper else []) + lines


def soccer_lineups(data, home_id):
    result = {}
    for roster in data.get("rosters") or []:
        side = roster.get("homeAway") or ("home" if str((roster.get("team") or {}).get("id")) == home_id else "away")
        players = []
        for entry in roster.get("roster") or []:
            athlete = entry.get("athlete") or {}
            plays = entry.get("plays") or []
            marks = []
            for play in plays:
                if play.get("didScore") or play.get("scoringPlay"):
                    marks.append("goal")
                if play.get("ownGoal"):
                    marks.append("owngoal")
                if play.get("yellowCard"):
                    marks.append("yellow")
                if play.get("redCard"):
                    marks.append("red")
            players.append({
                "id": str(athlete.get("id") or ""),
                "name": athlete.get("displayName") or "",
                "short": athlete.get("shortName") or athlete.get("lastName") or athlete.get("displayName") or "",
                "num": str(entry.get("jersey") or ""),
                "pos": ((entry.get("position") or {}).get("abbreviation") or ""),
                "place": int(num(entry.get("formationPlace"), 0) or 0),
                "starter": bool(entry.get("starter")),
                "subIn": bool(entry.get("subbedIn")),
                "subOut": bool(entry.get("subbedOut")),
                "marks": marks,
            })
        starters = [p for p in players if p["starter"]]
        formation = roster.get("formation") or ""
        if isinstance(formation, dict):
            formation = formation.get("name") or ""
        lines = formation_lines(starters, formation) if starters else []
        if not formation and lines:
            formation = "-".join(str(len(line)) for line in lines[1:])
        result[side] = {
            "formation": formation,
            "lines": lines,
            "bench": [p for p in players if not p["starter"]],
            "coach": "",
        }
    return result


def nba_players(boxscore, home_id):
    out = {}
    wanted = ("MIN", "PTS", "REB", "AST", "FG", "3PT", "+/-")
    for team in (boxscore or {}).get("players") or []:
        tid = str((team.get("team") or {}).get("id", ""))
        side = "home" if tid == home_id else "away"
        block = (team.get("statistics") or [{}])[0]
        labels = block.get("labels") or block.get("names") or []
        index = {label: i for i, label in enumerate(labels)}
        rows = []
        for athlete in block.get("athletes") or []:
            stats = athlete.get("stats") or []
            if not stats or athlete.get("didNotPlay"):
                continue
            person = athlete.get("athlete") or {}
            rows.append({
                "id": str(person.get("id") or ""),
                "name": person.get("shortName") or person.get("displayName") or "",
                "pos": ((person.get("position") or {}).get("abbreviation") or ""),
                "starter": bool(athlete.get("starter")),
                "cells": [stats[index[w]] if w in index and index[w] < len(stats) else "" for w in wanted],
            })
        out[side] = {"columns": list(wanted), "rows": rows}
    return out


def nba_leaders(data, home_id):
