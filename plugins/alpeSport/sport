                "value": str(int(num(entry.get("value"), 0) or 0)),
                "sub": ("%s Spiele" % games.group(1)) if games else "",
            })
        if rows:
            name = category.get("name") or ""
            categories.append({"key": name, "title": SOCCER_LEADER_TITLES.get(name, category.get("displayName") or name),
                               "rows": rows})
