def command_league(league_id):
    if league_id not in LEAGUE:
        return {"error": "unbekannter Wettbewerb: %s" % league_id}
    league = LEAGUE[league_id]
    fetch = Fetcher()
    now = today()
    if league["kind"] == "national":
        first, last = now - timedelta(days=200), now + timedelta(days=200)
    elif league["kind"] == "cup":
        first, last = now - timedelta(days=75), now + timedelta(days=75)
    elif league["sport"] == "basketball":
        first, last = now - timedelta(days=2), now + timedelta(days=5)
    else:
        first, last = now - timedelta(days=42), now + timedelta(days=21)
    logo = ""
    if league["source"] == "sihf":
        matches = sihf_results(fetch, first, last, 120)
        table, teams = sihf_standing(fetch, now, 300), []
    elif league["source"] == "sihf-nati":
        matches, table = sihf_national(fetch, first, last, 1800), None
    elif league["source"] == "espn-team":
        matches, table = espn_national(fetch, league["path"], first, last, 600), None
    else:
        # NBA: einzelne Tage (ein Monat waeren ueber 2 MB), sonst ganze Monate
        keys = espn_keys(first, last, by_month=league["sport"] != "basketball")
        matches, logo = espn_scoreboard(fetch, league_id, keys, 120)
        matches = [m for m in matches if first <= (local_date(parse_time(m["start"])) or first) <= last]
        table, teams = espn_standings(fetch, league_id, 600)
    if league["sport"] != "basketball" and table:
        add_form(table, matches)
    matches.sort(key=lambda m: (m["start"], m["home"]["name"]))
    info = league_info(league_id)
    info["logoUrl"] = national_logo(league_id, logo)
    holders = [info] + [t for m in matches for t in (m["home"], m["away"])]
    if table:
        holders += [row["team"] for g in table["groups"] for row in g["rows"]]
    fetch_logos(holders)
    return {
        "league": info,
        "matches": matches,
        "table": table,
        "updated": iso(datetime.now(timezone.utc)),
        "stale": fetch.stale,
        "errors": fetch.errors[:4],
    }


