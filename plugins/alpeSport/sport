def metric_height(text):
    """ESPN gibt Fuss und Zoll an («6' 2\"»); hier in Zentimetern."""
    found = re.match(r"\s*(\d+)'\s*(\d+)?", text or "")
    if not found:
        return text or ""
    return "%d cm" % round((int(found.group(1)) * 12 + int(found.group(2) or 0)) * 2.54)


