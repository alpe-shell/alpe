    side_of = lambda team_id: "home" if str(team_id) == home_id else "away" if str(team_id) == away_id else ""
    name_of = lambda licence: surname((players.get(licence) or {}).get("fullName", ""))

    events = []
    for index, period in enumerate((data.get("summary") or {}).get("periods") or []):
        for goal in period.get("goals") or []:
            score = goal.get("result") or {}
            assists = [name_of(goal.get(k)) for k in ("assist1LicenceNr", "assist2LicenceNr") if goal.get(k)]
            situation = ((goal.get("situation") or {}).get("code") or "").upper()
            tags = {"PP1": "Überzahl", "PP2": "Überzahl", "PP": "Überzahl", "SH1": "Unterzahl", "SH2": "Unterzahl",
                    "SH": "Unterzahl", "EN": "ins leere Tor"}
            extra = [tags[situation]] if situation in tags else []
            if goal.get("isEmptyNet") and "ins leere Tor" not in extra:
                extra.append("ins leere Tor")
