        for i in range(count):
            pick = lambda group, part: person((group.get(part) or [])[i]) if i < len(group.get(part) or []) else None
            block = {"name": "%d. Block" % (i + 1),
                     "forwards": [p for p in (pick(forwards, "left"), pick(forwards, "center"), pick(forwards, "right")) if p],
                     "defense": [p for p in (pick(defenders, "left"), pick(defenders, "right")) if p]}
            if block["forwards"] or block["defense"]:
                blocks.append(block)
        lineups[side] = {
            "goalies": [person(g) for g in lineup.get("goalkeepers") or []],
            "blocks": blocks,
            "coach": (lineup.get("coach") or {}).get("fullName", ""),
        }
    fetch_logos([match["home"], match["away"]])
    venue = details.get("venue") or {}
    referees = [r.get("fullName", "") for r in details.get("referees") or [] if r.get("fullName")]
    return {
        "match": match,
        "venue": ", ".join(x for x in (venue.get("name"), venue.get("city")) if x),
        "attendance": int(num(venue.get("spectators"), 0) or 0),
        "referee": " / ".join(referees),
        "periods": periods,
        "events": events,
        "stats": stats,
        "lineups": lineups,
        "leaders": leaders,
