    scores = result.get("scores") or []
    for period in scores[3:]:
        indicator = str(period.get("indicator") or period.get("name") or "").upper()
        decision = "SO" if "SO" in indicator or "PEN" in indicator or "SHOOT" in indicator else "OT"
    cells = {"homeTeam": details.get("homeTeam"), "awayTeam": details.get("awayTeam"),
             "score": {"homeTeam": result.get("homeTeam"), "awayTeam": result.get("awayTeam")},
             "status": data.get("status") or {}, "decision": decision, "details": {"gameId": data.get("gameId", game_id)},
