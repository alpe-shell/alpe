def german_season(text):
    """«2026-27 English Premier League» -> «English Premier League 2026/27»."""
    text = (text or "").strip()
    found = re.match(r"^(\d{4})-(\d{2})\s+(.*)$", text)
    if found:
        return "%s %s/%s" % (found.group(3), found.group(1), found.group(2))
    found = re.match(r"^(\d{4})\s+(.*)$", text)
    return "%s %s" % (found.group(2), found.group(1)) if found else text


