def espn_nba_leaders(fetch):
    def one(spec):
        key, title, sort, group, field = spec
        url = ESPN_WEB + "basketball/nba/statistics/byathlete?" + urllib.parse.urlencode(
            {"limit": 10, "sort": sort + ":desc", "category": group})
        data = fetch.json(url, 3600) or {}
        names = {c.get("name"): c.get("names") or [] for c in data.get("categories") or []}
        index = (names.get(group) or []).index(field) if field in (names.get(group) or []) else -1
        rows = []
        for rank, entry in enumerate((data.get("athletes") or [])[:10], 1):
            athlete = entry.get("athlete") or {}
            values = next((c.get("values") or [] for c in entry.get("categories") or [] if c.get("name") == group), [])
            value = values[index] if 0 <= index < len(values) else None
            abbr = athlete.get("teamShortName") or ""
            rows.append({
                "rank": rank,
                "player": {"id": str(athlete.get("id") or ""), "name": athlete.get("displayName") or "",
                           "short": athlete.get("shortName") or athlete.get("displayName") or ""},
                "team": {"id": str(athlete.get("teamId") or ""), "name": abbr, "abbr": abbr,
                         "logoUrl": logo_url("https://a.espncdn.com/i/teamlogos/nba/500/%s.png" % abbr.lower()) if abbr else ""},
                "value": "%.1f" % value if isinstance(value, (int, float)) else "",
                "sub": "pro Spiel",
            })
        return {"key": key, "title": title, "rows": rows} if rows else None
    with ThreadPoolExecutor(max_workers=3) as pool:
        return [c for c in pool.map(one, NBA_LEADERS) if c]


