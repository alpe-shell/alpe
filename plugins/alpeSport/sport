def espn_detail(fetch, league_id, game_id):
    league = LEAGUE[league_id]
    path = league["path"]
    if "~" in game_id:                              # Nationalteam: "<wettbewerb>~<spiel>"
        slug, game_id = game_id.split("~", 1)
        path = "soccer/" + slug
    data = fetch.json("%s%s/summary?event=%s" % (ESPN, path, urllib.parse.quote(game_id)), 20)
    if not data:
        return None
    header = data.get("header") or {}
    comp = (header.get("competitions") or [{}])[0]
    event = {"id": header.get("id") or game_id, "date": comp.get("date"), "status": comp.get("status")}
    match = espn_match(event, league_id, comp)
    home, away = match["home"], match["away"]
    labels = ("1. HZ", "2. HZ", "Verl. 1", "Verl. 2") if league["sport"] == "soccer" else ("Q1", "Q2", "Q3", "Q4")
    lines = {"home": [], "away": []}
    for competitor in comp.get("competitors") or []:
        side = "home" if competitor.get("homeAway") == "home" else "away"
        lines[side] = [str(l.get("displayValue", l.get("value", ""))).split(".")[0] for l in competitor.get("linescores") or []]
    periods = []
    for i in range(max(len(lines["home"]), len(lines["away"]))):
        if i < len(labels):
            name = labels[i]
        else:
            name = "OT%d" % (i - 3) if league["sport"] == "basketball" else "Pen."
        periods.append({"name": name,
                        "home": lines["home"][i] if i < len(lines["home"]) else "",
                        "away": lines["away"][i] if i < len(lines["away"]) else ""})
    info = data.get("gameInfo") or {}
    officials = info.get("officials") or []
    detail = {
        "match": match,
        "venue": ((info.get("venue") or {}).get("fullName") or match.get("venue") or ""),
        "attendance": int(num(info.get("attendance"), 0) or 0),
        "referee": ((officials[0] or {}).get("displayName") or (officials[0] or {}).get("fullName") or "") if officials else "",
        "periods": periods,
        "events": [],
        "stats": [],
        "lineups": {},
        "leaders": [],
        "players": {},
    }
    if league["sport"] == "soccer":
        detail["events"] = soccer_events(data, home, away)
        detail["stats"] = espn_team_stats(data.get("boxscore"), home["id"], SOCCER_STATS)
        detail["lineups"] = soccer_lineups(data, home["id"])
    else:
        detail["stats"] = espn_team_stats(data.get("boxscore"), home["id"], NBA_STATS)
        detail["players"] = nba_players(data.get("boxscore"), home["id"])
        detail["leaders"] = nba_leaders(data, home["id"])
    fetch_logos([home, away])
    return detail


