            "filterQuery": "%d/%s-%s" % (season_for(today()), today().strftime("%d.%m.%Y"), today().strftime("%d.%m.%Y"))})),
        ("sihf.ch Nati Eishockey", SIHF_NATI_PAGE),
        ("ESPN Logo", "https://a.espncdn.com/i/teamlogos/soccer/500/132.png"),
        ("Logo National League", TSDB % HOCKEY_LOGOS[101144]),
        ("ESPN Spieldetail", ESPN + "soccer/ger.1/summary?event=401884740"),
    ]
    out = []
    for name, url in checks:
        started = time.time()
        try:
            size = len(http_get(url))
            out.append({"name": name, "ok": True, "ms": int((time.time() - started) * 1000), "bytes": size})
        except (urllib.error.URLError, OSError) as error:
            out.append({"name": name, "ok": False, "ms": int((time.time() - started) * 1000),
                        "error": str(getattr(error, "reason", error)), "url": url})
    return {"checks": out}


# ---------------------------------------------------------------------------- Aufruf

def main(argv):
    command = argv[1] if len(argv) > 1 else ""
    started = time.time()
    if command == "logos" and len(argv) == 3:
        command_logos(argv[2])
        return 0
    try:
        if command == "leagues":
            result = command_leagues()
        elif command == "selftest":
            result = command_selftest()
            if "--text" in argv:
                for c in result["checks"]:
                    print("%-24s %s  %5d ms  %s" % (c["name"], "ok    " if c["ok"] else "FEHLER", c["ms"],
                                                     "%d KB" % (c["bytes"] // 1024) if c["ok"] else c["error"]))
                return 0 if all(c["ok"] for c in result["checks"]) else 1
        elif command == "day":
            day = today()
            if len(argv) > 2 and not argv[2].startswith("--"):
                day = date.fromisoformat(argv[2])
            leagues = []
            if "--leagues" in argv:
                leagues = [x for x in argv[argv.index("--leagues") + 1].split(",") if x]
            result = command_day(day, leagues)
        elif command == "league" and len(argv) == 3:
            result = command_league(argv[2])
        elif command == "match" and len(argv) == 4:
            result = command_match(argv[2], argv[3])
        elif command == "stats" and len(argv) == 3:
            result = command_stats(argv[2])
        elif command == "player" and len(argv) == 4:
            result = command_player(argv[2], argv[3])
        elif command == "cache":
            result = command_cache(clear="clear" in argv[2:])
        elif command == "watch":
            options = plugin_settings()
            option = lambda name, fallback: argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else fallback
            favorites = [x for x in option("--favorites", ",".join(options.get("favorites") or [])).split(",") if x]
            leagues = [x for x in option("--leagues", ",".join(row[0] for row in LEAGUES)).split(",") if x]
            kinds = [x for x in option("--notify", "goal,start,end").split(",") if x]
            result = command_watch(favorites, leagues, kinds, dry="--dry" in argv)
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except (ValueError, IndexError) as error:
        print(json.dumps({"error": "ungültige Angabe: %s" % error}))
        return 2
    except Exception as error:                     # die Oberflaeche soll immer JSON bekommen
        print(json.dumps({"error": "%s: %s" % (type(error).__name__, error)}))
        return 1
    text = json.dumps(result, ensure_ascii=False)
    if hasattr(sys.stdout, "buffer"):
        sys.stdout.buffer.write((text + "\n").encode("utf-8"))   # unabhaengig von der Locale
    else:
        sys.stdout.write(text + "\n")
    sys.stdout.flush()
    took = time.time() - started
    if took > 3:
        log("%s dauerte %.1f s, Antwort %d KB" % (" ".join(argv[1:]), took, len(text) // 1024))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
