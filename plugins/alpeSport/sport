def sihf_national(fetch, first, last, max_age):
    """Herren-Nationalteam (Eishockey): Resultate und Programm von sihf.ch. Die Statistik-Schnittstelle
    führt die Länderspiele nicht; die Seite liefert Datum, Turnier, Ort und Resultat, aber keine
    Anspielzeit und keinen Live-Stand."""
    key = os.path.join(cache_dir("http"), _key(SIHF_NATI_PAGE) + ".html")
    text = None
    try:
        if time.time() - os.path.getmtime(key) < max_age:
            text = open(key, encoding="utf-8").read()
    except OSError:
        pass
    if text is None:
        try:
            text = http_get(SIHF_NATI_PAGE).decode("utf-8", "replace")
            _write_atomic(key, text.encode("utf-8"))
        except (urllib.error.URLError, OSError) as error:
            fetch.errors.append("www.sihf.ch: %s" % getattr(error, "reason", error))
            try:
                text = open(key, encoding="utf-8").read()
                fetch.stale = True
            except OSError:
                return []
    parser = _Table()
    parser.feed(text)
    now = today()
    matches = []
    for row in parser.rows:
        if len(row) < 6 or not re.match(r"\d\d\.\d\d\.\d{4}$", row[0]):
            continue
        try:
            day = datetime.strptime(row[0], "%d.%m.%Y").date()
        except ValueError:
            continue
        if not (first <= day <= last):
            continue
        event, venue, home_name, away_name, result = row[1], row[2], row[3], row[4], row[5]
        home, away = country_team(home_name), country_team(away_name)
        score = re.match(r"\s*(\d+)\s*:\s*(\d+)\s*(?:\((\w+)\))?", result or "")
        played = bool(score) and (day < now or (day == now and (score.group(1), score.group(2)) != ("0", "0")))
        state, label = ("pre", "")
        if played:
            decision = (score.group(3) or "").upper()
            state, label = "post", {"OT": "Ende n.V.", "SO": "Ende n.P.", "PS": "Ende n.P."}.get(decision, "Ende")
            home["score"], away["score"] = score.group(1), score.group(2)
            h, a = int(score.group(1)), int(score.group(2))
            home["winner"], away["winner"] = h > a, a > h
        start = datetime(day.year, day.month, day.day, 12, 0).astimezone().astimezone(timezone.utc)
        matches.append({
            "id": "%s-%s-%s" % (day.strftime("%Y%m%d"), home["abbr"], away["abbr"]),
            "league": "sui.hockey", "sport": "hockey", "start": iso(start), "timeUnknown": True,
            "status": state, "label": label, "round": event, "home": home, "away": away,
            "venue": venue, "tv": [], "noDetail": True,
        })
    return matches


