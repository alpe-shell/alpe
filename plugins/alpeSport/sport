def hockey_status(status, decision=""):
    status = status or {}
    if status.get("canceled"):
        return "canceled", "Abgesagt"
    sid = status.get("id", 0)
    name = status.get("name") or ""
    percent = status.get("percent") or 0
    if sid == 0 or (percent == 0 and name.lower().startswith("wie geplant")):
        if "verschoben" in name.lower():
            return "postponed", "Verschoben"
        return "pre", ""
    if sid == 12 or percent >= 100 or name.lower().startswith("ende"):
        decision = (decision or "").upper()
        return "post", {"OT": "Ende n.V.", "SO": "Ende n.P.", "PS": "Ende n.P."}.get(decision, "Ende")
    return "live", name


def sihf_columns(table):
    return [(h or {}).get("alias", "") for h in table.get("header") or []]


def sihf_row(columns, row):
    return {alias: row[i] for i, alias in enumerate(columns) if i < len(row)}


def hockey_match(cells):
    status = cells.get("status") or {}
    result = cells.get("score") or {}
    decision = cells.get("decision") or ""
    state, label = hockey_status(status, decision)
    home = hockey_team(cells.get("homeTeam"), result.get("homeTeam"))
    away = hockey_team(cells.get("awayTeam"), result.get("awayTeam"))
    if state == "post":
        h, a = num(home["score"], 0), num(away["score"], 0)
        home["winner"], away["winner"] = h > a, a > h
    start = parse_time(status.get("startDateTime"))
    if not start and cells.get("date"):
        try:
            start = datetime.strptime("%s %s" % (cells["date"], cells.get("time") or "00:00"), "%d.%m.%Y %H:%M").astimezone().astimezone(timezone.utc)
        except ValueError:
            start = None
    periods = cells.get("scorePerPeriod") or {}
    return {
        "id": str((cells.get("details") or {}).get("gameId", "")),
        "league": "nl",
        "sport": "hockey",
        "start": iso(start),
        "status": state,
        "label": label,
        "round": "",
        "home": home,
        "away": away,
        "venue": "",
        "tv": [t for t in (cells.get("broadcasts") or {}).get("entries", []) if t],
        "periods": [{"home": h, "away": a} for h, a in zip(periods.get("homeTeam") or [], periods.get("awayTeam") or [])],
        "decision": decision,
    }


def sihf_results(fetch, first, last, max_age):
    season = season_for(first)
    query = urllib.parse.urlencode({
        "alias": "results", "searchQuery": "1//1", "filterBy": "Season,Date",
        "filterQuery": "%d/%s-%s" % (season, first.strftime("%d.%m.%Y"), last.strftime("%d.%m.%Y")),
        "orderBy": "date", "orderByDescending": "false", "language": "de",
    })
    data = fetch.json(SIHF + "cache300?" + query, max_age) or {}
    columns = sihf_columns(data)
    matches = []
    for row in data.get("data") or []:
        cells = sihf_row(columns, row)
        if isinstance(cells.get("homeTeam"), dict):
            matches.append(hockey_match(cells))
    return matches


def sihf_standing(fetch, day, max_age):
    season = season_for(day)
    query = urllib.parse.urlencode({
        "alias": "standing", "searchQuery": "1//1", "filterBy": "Season",
        "filterQuery": str(season), "language": "de",
    })
    data = fetch.json(SIHF + "cache300?" + query, max_age) or {}
    names = ["rank", "team", "gamesPlayed", "points", "pointsQuotient", "gamesWonInTime", "gamesWonExtraTime",
             "gamesWonPenalty", "gamesLostPenalty", "gamesLostExtraTime", "gamesLostInTime", "goalsFor",
             "goalsAgainst", "goalsDifference", "streak"]
    columns = sihf_columns(data)
    known = {c.lower(): c for c in columns}
    rows = []
    for raw in data.get("data") or []:
        cells = sihf_row(columns, raw)
        # Namen der Kopfzeile verwenden, sonst die dokumentierte Reihenfolge
        value = lambda key, i: cells.get(known.get(key.lower(), "\0"), raw[i] if i < len(raw) else "")
        team = value("team", 1)
        if not isinstance(team, dict) or not team.get("id"):
            continue                                   # Zeile «Durchschnitt»
        rank = int(num(value("rank", 0), 0) or 0)
        w = int(num(value("gamesWonInTime", 5), 0))
        otw = int(num(value("gamesWonExtraTime", 6), 0) + num(value("gamesWonPenalty", 7), 0))
        otl = int(num(value("gamesLostPenalty", 8), 0) + num(value("gamesLostExtraTime", 9), 0))
        l = int(num(value("gamesLostInTime", 10), 0))
        gf, ga = int(num(value("goalsFor", 11), 0)), int(num(value("goalsAgainst", 12), 0))
        rows.append({
            "rank": rank,
            "team": hockey_team(team),
            "cells": {"gp": str(int(num(value("gamesPlayed", 2), 0))), "w": str(w), "otw": str(otw), "otl": str(otl),
                      "l": str(l), "goals": "%d:%d" % (gf, ga), "gd": "%+d" % (gf - ga) if gf != ga else "0",
                      "pts": str(int(num(value("points", 3), 0)))},
            "zone": {"kind": "up", "label": "Playoffs"} if rank and rank <= 6 else
                    {"kind": "playin", "label": "Play-in"} if rank and rank <= 10 else None,
        })
    rows.sort(key=lambda r: r["rank"] or 99)
    if not rows:
        return None
    return {
        "columns": [
            {"key": "gp", "label": "Sp"}, {"key": "w", "label": "S"}, {"key": "otw", "label": "SnV"},
            {"key": "otl", "label": "NnV"}, {"key": "l", "label": "N"}, {"key": "goals", "label": "Tore", "wide": True},
            {"key": "gd", "label": "+/-"}, {"key": "pts", "label": "Pkt", "strong": True},
        ],
        "groups": [{"name": "", "rows": rows}],
    }


