def cache_dir(*parts):
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    path = os.path.join(base, "alpe", "sport", *parts)
    os.makedirs(path, exist_ok=True)
    return path


def _key(text):
    return hashlib.sha1(text.encode()).hexdigest()


def http_get(url):
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "application/json, */*"})
    with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT) as response:
        return response.read()


def _write_atomic(path, payload):
    folder = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".tmp-")
    with os.fdopen(fd, "wb") as handle:
        handle.write(payload)
    os.replace(tmp, path)


def log(line):
    """Kurzes Protokoll unter ~/.cache/alpe/sport/log.txt (die letzten 200 Zeilen)."""
    path = os.path.join(cache_dir(), "log.txt")
    try:
        try:
            lines = open(path, encoding="utf-8").read().splitlines()[-199:]
        except OSError:
            lines = []
        lines.append("%s %s" % (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), line))
        _write_atomic(path, ("\n".join(lines) + "\n").encode("utf-8"))
    except OSError:
        pass


class Fetcher:
    """JSON holen mit Zwischenspeicher. Bei einem Fehler gilt der letzte Stand (stale)."""

    def __init__(self):
        self.errors = []
        self.stale = False

    def json(self, url, max_age):
        path = os.path.join(cache_dir("http"), _key(url) + ".json")
        cached = None
        try:
            with open(path) as handle:
                cached = json.load(handle)
            if time.time() - cached.get("t", 0) < max_age:
                return cached["data"]
        except (OSError, ValueError, KeyError, TypeError):
            cached = None
        started = time.time()
        try:
            data = json.loads(http_get(url).decode("utf-8"))
            if time.time() - started > 5:
                log("langsam %.1f s %s" % (time.time() - started, url))
        except (urllib.error.URLError, OSError, ValueError) as error:
            host = urllib.parse.urlparse(url).netloc
            self.errors.append("%s: %s" % (host, getattr(error, "reason", error)))
            log("Fehler nach %.1f s: %s %s" % (time.time() - started, getattr(error, "reason", error), url))
            if cached is not None:
                self.stale = True
                return cached.get("data")
            return None
        try:
            _write_atomic(path, json.dumps({"t": time.time(), "data": data}).encode())
        except OSError:
            pass
        return data


