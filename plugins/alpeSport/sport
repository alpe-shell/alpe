# ---------------------------------------------------------------------------- ESPN

def pick_logo(logos):
    """ESPN liefert oft eine helle und eine dunkle Fassung; die Shell ist dunkel."""
    logos = [l for l in logos or [] if isinstance(l, dict) and l.get("href")]
    for logo in logos:
        if "dark" in (logo.get("rel") or []):
            return logo["href"]
    return logos[0]["href"] if logos else ""


def espn_team(competitor):
    team = competitor.get("team") or {}
    logo = pick_logo(team.get("logos")) or team.get("logo") or ""
    score = competitor.get("score")
    if isinstance(score, dict):
        score = score.get("displayValue") or score.get("value")
    out = {
        "id": str(team.get("id", "")),
        "name": team.get("displayName") or team.get("name") or "",
        "short": team.get("shortDisplayName") or team.get("name") or team.get("displayName") or "",
        "abbr": team.get("abbreviation") or "",
        "color": ("#" + team["color"]) if team.get("color") else "",
        "logoUrl": logo_url(logo),
        "score": "" if score in (None, "") else str(score).split(".")[0],
        "winner": bool(competitor.get("winner")),
    }
    if competitor.get("shootoutScore") not in (None, ""):
        out["penalties"] = str(competitor["shootoutScore"]).split(".")[0]
    records = competitor.get("records") or []
    if isinstance(records, list) and records:
        total = next((r for r in records if (r or {}).get("type") in ("total", "overall")), records[0]) or {}
        out["record"] = total.get("summary", "")
    return out


def espn_status(status, sport):
    status = status or {}
    kind = status.get("type") or {}
    name = kind.get("name", "")
    state = kind.get("state", "pre")
    period = status.get("period") or 0
    clock = status.get("displayClock") or ""
    short = kind.get("shortDetail") or kind.get("detail") or ""
    if name in ("STATUS_POSTPONED", "STATUS_DELAYED"):
        return "postponed", "Verschoben"
    if name in ("STATUS_CANCELED", "STATUS_ABANDONED", "STATUS_FORFEIT"):
        return "canceled", "Abgesagt"
    if name == "STATUS_SUSPENDED":
        return "live", "Unterbrochen"
    if state == "pre":
        return "pre", ""
    if state == "post":
        if sport == "soccer":
            if "PEN" in name:
                return "post", "n.P."
            if "AET" in name or "EXTRA" in name:
                return "post", "n.V."
            return "post", "Ende"
        return "post", "Ende n.V." if period > 4 or "OT" in short else "Ende"
    # laeuft
    if name in ("STATUS_HALFTIME",) or short.lower().startswith("half"):
        return "live", "Pause"
    if sport == "soccer":
        if name == "STATUS_SHOOTOUT":
            return "live", "Penaltys"
        if name in ("STATUS_END_OF_REGULATION", "STATUS_END_OF_EXTRATIME"):
            return "live", "Pause"
        return "live", clock or short
    if name == "STATUS_END_PERIOD" or short.lower().startswith("end of"):
        return "live", "Ende Q%d" % period if period <= 4 else "Ende OT"
    quarter = "Q%d" % period if period <= 4 else ("OT" if period == 5 else "OT%d" % (period - 4))
    return "live", ("%s %s" % (quarter, clock)).strip()


def espn_match(event, league_id, competition=None):
    comp = competition or (event.get("competitions") or [{}])[0]
    sport = LEAGUE[league_id]["sport"]
    competitors = comp.get("competitors") or []
    home = next((c for c in competitors if c.get("homeAway") == "home"), competitors[0] if competitors else {})
    away = next((c for c in competitors if c.get("homeAway") == "away"), competitors[1] if len(competitors) > 1 else {})
    state, label = espn_status(event.get("status") or comp.get("status"), sport)
    start = parse_time(event.get("date") or comp.get("date"))
    notes = comp.get("notes") or event.get("notes") or []
    note = (notes[0] or {}).get("headline", "") if notes else ""
    if not note and isinstance(event.get("season"), dict) and LEAGUE[league_id]["kind"] != "league":
        note = event["season"].get("slug", "")
    teams = [espn_team(home), espn_team(away)]
    if sport != "basketball":                       # Bilanz (S-N) gibt es nur fuer die NBA
        for team in teams:
            team.pop("record", None)
    return {
        "id": str(event.get("id") or comp.get("id") or ""),
        "league": league_id,
        "sport": sport,
        "start": iso(start),
        "status": state,
        "label": label,
        "round": german_round(note),
        "home": teams[0],
        "away": teams[1],
        "venue": ((comp.get("venue") or {}).get("fullName") or ""),
        "tv": [],
    }


def espn_keys(first, last, by_month=False):
    """Werte fuer dates=. ESPN nimmt seit Nov. 2026 keine Spannen (A-B) mehr an (HTTP 400),
    wohl aber einzelne Tage (JJJJMMTT) und ganze Monate (JJJJMM)."""
    keys, day = [], first
    while day <= last:
        key = day.strftime("%Y%m") if by_month else day.strftime("%Y%m%d")
        if key not in keys:
            keys.append(key)
        day += timedelta(days=1)
    return keys


def espn_scoreboard(fetch, league_id, keys, max_age):
    path = LEAGUE[league_id]["path"]
    urls = ["%s%s/scoreboard?dates=%s" % (ESPN, path, key) for key in keys]
    with ThreadPoolExecutor(max_workers=6) as pool:
        pages = list(pool.map(lambda url: fetch.json(url, max_age) or {}, urls))
    matches, seen, logo = [], set(), ""
    for data in pages:
        for event in data.get("events") or []:
            match = espn_match(event, league_id)
            if match["id"] and match["id"] not in seen:
                seen.add(match["id"])
                matches.append(match)
        leagues = data.get("leagues") or []
        if leagues and not logo:
            logo = logo_url(pick_logo(leagues[0].get("logos")))
    return matches, logo


