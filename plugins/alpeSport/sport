                                "points": points, "goals": int(num(cells.get("goals"), 0) or 0)})
    scorers.sort(key=lambda s: (-s["points"], -s["goals"]))
    for item in scorers[:4]:
        item.pop("points"), item.pop("goals")
        leaders.append(item)

    def person(pid):
        p = players.get(pid) or {}
        return {"id": p.get("fullName", ""), "name": p.get("fullName", ""), "short": surname(p.get("fullName", "")),
                "num": str(p.get("jerseyNumber") or "")}

    lineups = {}
