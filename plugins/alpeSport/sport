def notify(title, body, icon):
    """Mitteilung an die Shell (freedesktop). Zum Testen: ALPE_SPORT_NOTIFY_LOG=datei schreibt nur mit."""
    target = os.environ.get("ALPE_SPORT_NOTIFY_LOG")
    if target:
        with open(target, "a", encoding="utf-8") as handle:
            handle.write(json.dumps({"title": title, "body": body, "icon": icon}, ensure_ascii=False) + "\n")
        return
    import shutil
    import subprocess
    if shutil.which("notify-send"):
        command = ["notify-send", "--app-name=Sport", "--icon=" + (icon or "trophy"), title, body]
    else:
        quote = lambda text: '"%s"' % text.replace("\\", "\\\\").replace('"', '\\"')
        command = ["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                   "--object-path", "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.Notify",
                   "Sport", "0", icon or "trophy", title, body, "[]", "{}", "8000"]
    try:
        subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=10, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        log("Mitteilung nicht gesendet: %s" % error)


def match_line(match):
    home, away = match["home"], match["away"]
    return "%s %s:%s %s" % (home.get("short") or home["name"], home.get("score") or "0", away.get("score") or "0",
                            away.get("short") or away["name"])


def watch_events(previous, match):
    """Ereignisse zwischen zwei Ständen eines Spiels: start, goal, end."""
    if not previous:
        return []
    events = []
    was, now = previous.get("status"), match["status"]
    if was == "pre" and now == "live":
        events.append({"kind": "start", "side": ""})
    if match["sport"] != "basketball" and now in ("live", "post"):
        for side in ("home", "away"):
            before, after = int(previous.get(side, 0)), score_of(match[side])
            for _ in range(max(0, min(after - before, 3))):
                events.append({"kind": "goal", "side": side})
    if was in ("pre", "live") and now == "post":
        events.append({"kind": "end", "side": ""})
    return events


def event_text(kind, side, match):
    league = LEAGUE.get(match["league"], {}).get("short", "")
    if kind == "start":
        return ("Spielbeginn" if match["sport"] != "soccer" else "Anpfiff") + (" · " + league if league else ""), \
            "%s – %s" % (match["home"].get("short") or match["home"]["name"], match["away"].get("short") or match["away"]["name"]), \
            match["home"].get("logo") or ""
    if kind == "goal":
        team = match[side]
        clock = match.get("label") or ""
        return "Tor für %s" % (team.get("short") or team["name"]), match_line(match) + ("  ·  " + clock if clock else ""), \
            team.get("logo") or ""
    label = match.get("label") or ""
    extra = "" if label in ("", "Ende") else " (%s)" % label.replace("Ende ", "")
    winner = next((match[s] for s in ("home", "away") if match[s].get("winner")), None)
    return "Schluss" + (" · " + league if league else ""), match_line(match) + extra, \
        (winner or match["home"]).get("logo") or ""


def command_watch(favorites, league_ids, kinds, dry=False):
    path = os.path.join(cache_dir(), "watch.json")
    day = today()
    try:
        with open(path, encoding="utf-8") as handle:
            state = json.load(handle)
    except (OSError, ValueError):
        state = {}
    if state.get("day") != day.isoformat():
        state = {"day": day.isoformat(), "matches": {}, "plan": {}, "planned": 0, "leagues": []}
    favorites = set(favorites)
    sports = {f.split(":", 1)[0] for f in favorites}
    ids = [i for i in league_ids if i in LEAGUE and LEAGUE[i]["sport"] in sports]
    fetch = Fetcher()
    is_favorite = lambda m: "%s:%s" % (m["sport"], m["home"]["id"]) in favorites or \
        "%s:%s" % (m["sport"], m["away"]["id"]) in favorites
    now = datetime.now(timezone.utc)

    fresh = {}
    if time.time() - state.get("planned", 0) > PLAN_AGE or sorted(state.get("leagues", [])) != sorted(ids):
        with ThreadPoolExecutor(max_workers=8) as pool:
            for league_id, (found, _) in pool.map(lambda i: (i, league_day(fetch, i, day, PLAN_AGE)), ids):
                fresh[league_id] = found
        state["plan"] = {i: [m["id"] for m in found if is_favorite(m)] for i, found in fresh.items()}
        state["plan"] = {i: v for i, v in state["plan"].items() if v}
        state["planned"], state["leagues"] = time.time(), ids

    def hot(league_id):
        for match_id in state["plan"].get(league_id, []):
            known = state["matches"].get("%s/%s" % (league_id, match_id))
            if not known or known["status"] == "live":
                return True
            start = parse_time(known.get("start"))
            if known["status"] == "pre" and start and start - now < timedelta(minutes=15):
                return True
        return False

    def current(league_id):
        heat = hot(league_id)
        if league_id in fresh and not heat:
            return fresh[league_id]
        return league_day(fetch, league_id, day, HOT_AGE if heat else PLAN_AGE)[0]

    matches = []
    with ThreadPoolExecutor(max_workers=8) as pool:
        for league_id, found in pool.map(lambda i: (i, current(i)), list(state["plan"])):
            wanted = set(state["plan"][league_id])
            matches += [m for m in found if m["id"] in wanted]
    fetch_logos([t for m in matches for t in (m["home"], m["away"])], wait=1.0)

    events = []
    for match in matches:
        key = "%s/%s" % (match["league"], match["id"])
        for event in watch_events(state["matches"].get(key), match):
            title, body, icon = event_text(event["kind"], event["side"], match)
            event.update({"match": key, "title": title, "body": body})
            events.append(event)
            if event["kind"] in kinds and not dry:
                notify(title, body, icon)
        state["matches"][key] = {"status": match["status"], "start": match["start"],
                                 "home": score_of(match["home"]), "away": score_of(match["away"])}
    try:
        _write_atomic(path, json.dumps(state).encode())
    except OSError:
        pass

    matches.sort(key=lambda m: (m["status"] != "live", m["status"] == "post", m["start"] or ""))
    any_hot = any(hot(i) for i in state["plan"])
    upcoming = [parse_time(m["start"]) for m in matches if m["status"] == "pre" and m["start"]]
    if any_hot:
        wait = HOT_AGE + 5
    elif upcoming:
        wait = int(max(60, min(PLAN_AGE, (min(upcoming) - now).total_seconds() - 600)))
    else:
        wait = PLAN_AGE
    return {"matches": matches, "events": events, "hot": any_hot, "next": wait,
            "updated": iso(now), "stale": fetch.stale, "errors": fetch.errors[:4]}


