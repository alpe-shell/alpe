def sihf_leaders(fetch, season):
    players = [p for p in sihf_players(fetch, season) if p.get("Spieler")]
    goalies = [g for g in sihf_players(fetch, season, goalies=True) if g.get("Spieler")]
    value = lambda row, key: num(row.get(key), 0) or 0

    def category(key, title, rows, sort, show, sub):
        ordered = sorted(rows, key=sort)[:10]
        return {"key": key, "title": title, "rows": [{
            "rank": i + 1,
            "player": {"id": r["Spieler"], "name": r["Spieler"], "short": surname(r["Spieler"])},
            "team": sihf_stat_team(r.get("Team")), "value": show(r), "sub": sub(r),
        } for i, r in enumerate(ordered)]}

    out = []
    if players:
        out.append(category("points", "Skorer", players, lambda r: (-value(r, "PTS"), -value(r, "G")),
                            lambda r: str(int(value(r, "PTS"))), lambda r: "%d T · %d A" % (value(r, "G"), value(r, "A"))))
        out.append(category("goals", "Tore", players, lambda r: (-value(r, "G"), value(r, "GP")),
                            lambda r: str(int(value(r, "G"))), lambda r: "%d Spiele" % value(r, "GP")))
        out.append(category("assists", "Assists", players, lambda r: (-value(r, "A"), value(r, "GP")),
                            lambda r: str(int(value(r, "A"))), lambda r: "%d Spiele" % value(r, "GP")))
        out.append(category("plusminus", "Plus/Minus", players, lambda r: -value(r, "+/-"),
                            lambda r: "%+d" % value(r, "+/-"), lambda r: "%d Spiele" % value(r, "GP")))
    if goalies:
        most = max(value(g, "GPI") for g in goalies)
        regular = [g for g in goalies if value(g, "GPI") >= max(2, most / 3)]
        out.append(category("saves", "Torhüter", regular, lambda r: -value(r, "SVS%"),
                            lambda r: "%.2f %%" % value(r, "SVS%"), lambda r: "%.2f GAA · %d Sp." % (value(r, "GAA"), value(r, "GPI"))))
    return out


