def command_cache(clear=False):
    base = cache_dir()
    if clear:
        import shutil
        for part in ("http", "logos"):
            shutil.rmtree(os.path.join(base, part), ignore_errors=True)
        for name in ("watch.json",):
            try:
                os.remove(os.path.join(base, name))
            except OSError:
                pass
    size, files = 0, 0
    for folder, _, names in os.walk(base):
        for name in names:
            try:
                size += os.path.getsize(os.path.join(folder, name))
                files += 1
            except OSError:
                pass
    return {"bytes": size, "files": files, "path": base}


