def german_competition(name):
    low = (name or "").lower()
    for pattern, german in COMPETITIONS:
        if re.search(pattern, low):
            return german
    return name or ""


def espn_national(fetch, team_id, first, last, max_age):
    """Spiele des Nationalteams über den Spielplan des Teams bei ESPN (alle Wettbewerbe).
    ESPN ordnet nach Saison-Jahr; deshalb beide in Frage kommenden Jahre holen."""
    years = sorted({first.year, last.year, today().year + 1})
    urls = ["%ssoccer/all/teams/%s/schedule?season=%d" % (ESPN, team_id, year) for year in years]
    urls += ["%ssoccer/all/teams/%s/schedule?season=%d&fixture=true" % (ESPN, team_id, year) for year in years]
    with ThreadPoolExecutor(max_workers=6) as pool:
        pages = list(pool.map(lambda url: fetch.json(url, max_age) or {}, urls))
    matches, seen = [], set()
    for data in pages:
        for event in data.get("events") or []:
            league = event.get("league") or {}
            slug = league.get("slug") or ""
            match = espn_match(event, "sui.nt")
            if not match["id"] or not slug or match["id"] in seen:
                continue
            seen.add(match["id"])
            parts = [german_competition(league.get("name") or league.get("abbreviation") or "")]
            if match["round"]:
                parts.append(match["round"])
            match["round"] = " · ".join(p for p in parts if p)
            match["id"] = "%s~%s" % (slug, match["id"])          # fuer das Spieldetail
            matches.append(match)
    return [m for m in matches if first <= (local_date(parse_time(m["start"])) or first) <= last]


class _Table(html.parser.HTMLParser):
    """Liest die Zeilen der ersten Tabelle einer Seite (Zelltexte)."""

    def __init__(self):
        super().__init__()
        self.rows, self._row, self._cell, self._in = [], None, None, False

    def handle_starttag(self, tag, attrs):
        if tag == "tr":
            self._row = []
        elif tag in ("td", "th") and self._row is not None:
            self._cell = []

    def handle_endtag(self, tag):
        if tag in ("td", "th") and self._row is not None and self._cell is not None:
            self._row.append(" ".join("".join(self._cell).split()))
            self._cell = None
        elif tag == "tr" and self._row is not None:
            if self._row:
                self.rows.append(self._row)
            self._row = None

    def handle_data(self, data):
        if self._cell is not None:
            self._cell.append(data)


